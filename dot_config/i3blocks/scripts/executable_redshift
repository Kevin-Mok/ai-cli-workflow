#!/usr/bin/env python3
"""Display the shared manual Redshift target and route wheel adjustments."""
import os
from pathlib import Path
import subprocess


def main():
    controller = Path.home() / "scripts/redshift-control"
    step = {"4": "150", "5": "-150"}.get(os.environ.get("BLOCK_BUTTON", ""))
    try:
        if step is not None:
            subprocess.run([str(controller), "adjust", step], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        result = subprocess.run([str(controller), "status"], check=True,
                                capture_output=True, text=True)
        temperature = int(result.stdout)
        if not 1000 <= temperature <= 6500:
            raise ValueError("Invalid controller status")
    except (OSError, ValueError, subprocess.SubprocessError):
        print("🌡️ ERR")
        return
    print(f"🌡️ {temperature} K")


if __name__ == "__main__":
    main()
