#!/usr/bin/python3
"""Fit the 4K song to the live bar while reserving space for volume and Redshift."""
import html
import json
import math
import os
from queue import Empty, SimpleQueue
from pathlib import Path
import re
import signal
import subprocess
import sys
import threading


def fit_song(markup, width, measure):
    if measure(markup) <= width:
        return markup
    match = re.match(r"(.*</span>\s?)(.*)", markup)
    prefix, track = match.groups() if match else ("", markup)
    track = html.unescape(track)
    # Media filenames keep their extension and descriptive ending.
    keep_end = bool(re.search(r"\.(?:mp4|mkv|webm|mov|m4v|avi|mpg|mpeg|ts|mts|m2ts|wmv|flv|3gp|"
                              r"mp3|m4a|flac|ogg|opus|wav|aac)$", track, re.IGNORECASE))

    def candidate(length):
        fragment = track[-length:].lstrip() if keep_end and length else track[:length].rstrip()
        fragment = html.escape(fragment)
        return prefix + ("…" + fragment if keep_end else fragment + "…")

    if measure(prefix + "…") > width:
        return "…" if measure("…") <= width else ""
    low, high = 0, len(track)
    while low < high:
        middle = (low + high + 1) // 2
        if measure(candidate(middle)) <= width:
            low = middle
        else:
            high = middle - 1
    return candidate(low)


def layout_blocks(blocks, screen_width, workspace_width, measure, border_scale=1):
    blocks = [dict(block) for block in blocks]
    song = next((b for b in blocks if b.get("name") == "spotify"), None)
    volume = next((b for b in blocks if b.get("name") == "volume"), None)
    if song is None or volume is None:
        return blocks
    calendar = next((b for b in blocks if b.get("name") == "calendar"), None)
    left = workspace_width + 8

    def smaller(markup):
        return f'<span size="70%">{markup}</span>' if markup else ""

    def measure_song(markup):
        return measure(smaller(markup))

    def border_width(block):
        return sum(math.ceil(block.get(key, 0) * border_scale) for key in ("border_left", "border_right"))

    def song_budget():
        visible = [b for b in blocks if b.get("full_text")]
        separators = sum(b.get("separator_block_width", 9) for b in blocks[:-1] if b.get("full_text"))
        fixed_width = sum(measure(b["full_text"]) for b in visible if b is not song)
        fixed_width += sum(border_width(b) for b in visible)
        return int(screen_width - left - fixed_width - separators)

    budget = song_budget()
    prefix = re.match(r"(.*</span>\s?)", song["full_text"])
    minimum_song_width = measure_song(prefix.group(1) + "…") if prefix else 0
    if budget < minimum_song_width and calendar:
        calendar["full_text"] = calendar.get("short_text", "")
        budget = song_budget()
    if budget < minimum_song_width and calendar:
        calendar["full_text"] = ""
        budget = song_budget()
    song["full_text"] = smaller(fit_song(song["full_text"], max(0, budget), measure_song))
    # Native short-form selection must not undo the measured layout.
    for block in blocks:
        block.pop("short_text", None)
    return blocks


def transform_line(line, transform):
    prefix = "," if line.startswith(",") else ""
    try:
        blocks = json.loads(line[len(prefix):])
    except ValueError:
        return line
    if not isinstance(blocks, list):
        return line
    return prefix + json.dumps(transform(blocks), ensure_ascii=False) + "\n"


def ipc(kind, *args):
    result = subprocess.run(["i3-msg", "-t", kind, *args], capture_output=True,
                            text=True, check=True, timeout=1)
    return json.loads(result.stdout)


def workspace_button_width(name, measure, dpi, minimum, strip_numbers=False):
    if strip_numbers:
        name = re.sub(r"^\d+:?", "", name)
    padding = 2 * round(4 * dpi / 96) + round(dpi / 96)
    return max(measure(name) + padding, round(minimum * dpi / 96))


def live_layout():
    import gi
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Pango, PangoCairo

    resources = subprocess.run(["xrdb", "-query"], capture_output=True,
                               text=True, check=True, timeout=1).stdout
    dpi_match = re.search(r"^Xft.dpi:\s*([\d.]+)", resources, re.MULTILINE)
    dpi = float(dpi_match[1]) if dpi_match else 96
    bars = [ipc("get_bar_config", name) for name in ipc("get_bar_config")]
    bar = next(b for b in bars if "DP-2" in b.get("outputs", []))
    context = PangoCairo.FontMap.get_default().create_context()
    PangoCairo.context_set_resolution(context, dpi)
    layout = Pango.Layout.new(context)
    layout.set_font_description(Pango.FontDescription.from_string(bar["font"].removeprefix("pango:")))

    def measure(markup):
        layout.set_markup(markup, -1)
        return layout.get_pixel_size().width

    def adapt(blocks):
        output = next(o for o in ipc("get_outputs") if o["name"] == "DP-2")
        workspaces = [w for w in ipc("get_workspaces") if w["output"] == "DP-2"]
        workspace_width = sum(workspace_button_width(w["name"], measure, dpi,
                              bar.get("workspace_min_width", 0),
                              bar.get("strip_workspace_numbers", False)) for w in workspaces)
        return layout_blocks(blocks, output["rect"]["width"], workspace_width, measure, dpi / 96)

    return adapt


def forward_clicks(source, child, updates):
    """Keep wheel events queued in the pipe instead of i3blocks' busy block."""
    for line in source:
        try:
            event = json.loads(line.lstrip(","))
        except ValueError:
            event = None
        if isinstance(event, dict) and event.get("name") == "redshift" and event.get("button") in (4, 5):
            try:
                result = subprocess.run(
                    [str(Path.home() / ".config/i3blocks/scripts/redshift")],
                    env={**os.environ, "BLOCK_BUTTON": str(event["button"])},
                    capture_output=True, text=True, check=True,
                )
                text = result.stdout.strip().splitlines()[0]
            except (OSError, subprocess.SubprocessError, IndexError):
                text = "🌡️ ERR"
            updates.put(text)
            # Signal 2 is reserved by the Redshift stanza in this bar only.
            try:
                child.send_signal(signal.SIGRTMIN + 2)
            except ProcessLookupError:
                return
        else:
            try:
                child.stdin.write(line)
                child.stdin.flush()
            except (BrokenPipeError, ValueError):
                return
    child.stdin.close()


ICON_GAP = '<span size="1" letter_spacing="20480"> </span>'
ICON_PATTERN = re.compile(r"(🔉|🔊|🔈|🔇|🎧|🖥️|🌡️|🎵|🔔|🔕|📅|🕒|▶️|⏸️|🔋|📶|🔆)(</span>)?")


def pad_blocks(blocks, right=25):
    padded = []
    for block in blocks:
        block = dict(block, border="#00000000", border_top=0, border_bottom=0,
                     border_left=0, border_right=right)
        for key in ("full_text", "short_text"):
            if block.get(key):
                block[key] = ICON_PATTERN.sub(lambda match: match[0] + ICON_GAP, block[key],
                                              count=2 if block.get("name") == "spotify" else 1)
        padded.append(block)
    return padded


def main():
    config = Path(sys.argv[1]).expanduser() if len(sys.argv) > 1 else Path.home() / ".config/i3blocks/i3blocks-4k.conf"
    try:
        resources = subprocess.check_output(["xrdb", "-query"], text=True, stderr=subprocess.DEVNULL, timeout=1)
        match = re.search(r"^Xft.dpi:\s*([\d.]+)", resources, re.MULTILINE)
        dpi = float(match[1]) if match else 96
    except (OSError, subprocess.SubprocessError):
        dpi = 96
    padding = max(0, round(25 * 96 / dpi))
    child = subprocess.Popen(
        ["i3blocks", "-c", str(config)],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1,
    )
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    updates = SimpleQueue()
    threading.Thread(target=forward_clicks, args=(sys.stdin, child, updates), daemon=True).start()
    warned = False
    adapt = (lambda blocks: blocks) if len(sys.argv) > 1 else None
    try:
        for line in child.stdout:
            latest = None
            try:
                while True:
                    latest = updates.get_nowait()
            except Empty:
                pass
            if latest is not None:
                def overlay(blocks):
                    for block in blocks:
                        if block.get("name") == "redshift":
                            block["full_text"] = latest
                    return blocks
                line = transform_line(line, overlay)
            line = transform_line(line, lambda blocks: pad_blocks(blocks, padding))
            try:
                if adapt is None:
                    adapt = live_layout()
                rendered = transform_line(line, adapt)
            except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError, StopIteration) as error:
                if not warned:
                    print(f"⚠️ 4K bar layout unavailable ({type(error).__name__}); keeping volume and Redshift priority.", file=sys.stderr)
                warned = True
                adapt = None
                rendered = line
            sys.stdout.write(rendered)
            sys.stdout.flush()
    finally:
        child.terminate()
        child.wait(timeout=3)


if __name__ == "__main__":
    main()
