#!/usr/bin/env bash
# Left: full notifications; middle: visuals only; right: Do Not Disturb.
set -e
mute="${XDG_CONFIG_HOME:-$HOME/.config}/codex-notification-sound/audio-muted"
case "${BLOCK_BUTTON:-}" in
  1) rm -f -- "$mute"; dunstctl set-paused false ;;
  2) mkdir -p -- "$(dirname -- "$mute")"; touch -- "$mute"; dunstctl set-paused false ;;
  3) dunstctl set-paused true ;;
esac
if [[ "$(dunstctl is-paused 2>/dev/null)" == true ]]; then
  waiting=$(dunstctl count waiting 2>/dev/null || echo 0)
  if (( waiting > 0 )); then echo "<span color='#ff6b6b'>🔕DND ($waiting)</span>"; else echo "<span color='#ff6b6b'>🔕DND</span>"; fi
else
  label="🔔Notis"
  if [[ -e "$mute" ]]; then label="🔇Silent"; fi
  if [[ -r "$HOME/.cache/wal/colors.sh" ]]; then
    source "$HOME/.cache/wal/colors.sh"
  fi
  if [[ -n "${color7:-}" ]]; then
    echo "<span color=\"$color7\">$label</span>"
  else
    echo "$label"
  fi
fi
