# vim: fdm=marker ft=conf.go-template

#  global [[[ #

# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
align=center
command=~/.config/i3blocks/scripts/$BLOCK_NAME
separator=true
separator_block_width=25
markup=pango
color=#cbe4ff

#  ]]] global #

#  volume/spotify [[[ #

[volume]
interval=once
signal=1
interval=60

[redshift]
interval=1
signal=2

[spotify]
# Let i3bar drop the song before workspace pressure clips the volume.
command=~/.config/i3blocks/scripts/now_playing_mpris | sed '2c<span></span>'
label=
interval=5

#  ]]] volume/spotify #

#  time [[[ #

[calendar]
interval=1
