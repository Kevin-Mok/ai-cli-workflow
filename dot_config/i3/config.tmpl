bindsym $mod+Mod4+1 exec --no-startup-id ~/scripts/redshift-control set 1800
bindsym Mod4+2 exec --no-startup-id ~/scripts/redshift-control set 2300
bindsym $mod+Mod4+2 exec --no-startup-id ~/scripts/redshift-control set 2300
