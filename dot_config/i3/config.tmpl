bindsym $mod+Mod4+5 exec --no-startup-id ~/scripts/redshift-control set 3900
bindsym Mod4+6 exec --no-startup-id ~/scripts/redshift-control set 4400
bindsym $mod+Mod4+6 exec --no-startup-id ~/scripts/redshift-control set 4400
bindsym Mod4+7 exec --no-startup-id ~/scripts/redshift-control set 4950
