#  redshift [[[ # 

# Ctrl+Alt+Up/Down: cooler/warmer in 250 K steps.
bindsym Control+$mod+Up exec --no-startup-id ~/scripts/redshift-control adjust 250
bindsym Control+$mod+Down exec --no-startup-id ~/scripts/redshift-control adjust -250
