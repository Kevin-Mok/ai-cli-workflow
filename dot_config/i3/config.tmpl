#  reload config [[[ # 

bindsym Control+$mod+r exec i3-msg restart
bindsym $mod+Shift+c reload
# bindsym $mod+Control+r reload
bindsym $mod+Control+u exec xrdb ~/.Xresources && grep wallpaper ~/.cache/wal/colors.sh | cut -d\' -f2 | xargs /home/example/scripts/apply-pywal-theme > /dev/null

# exit i3 (logs you out of your X session)
bindsym Control+$mod+s exec systemctl suspend
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

