#!/usr/bin/env python3
"""Allocate Fortnite inventory across the local dates before season cutoff."""

import argparse
from datetime import date, timedelta
import os
import re
import sys


DEFAULT_CUTOFF = date(2026, 12, 4)


def dust_amount(value: str) -> int:
    match = re.fullmatch(r"([0-9]+|[0-9]{1,3}(?:,[0-9]{3})+)([kK]?)", value)
    if match is None:
        raise argparse.ArgumentTypeError("enter whole dust, such as 178000, 178,000, or 178k")
    amount, suffix = match.groups()
    return int(amount.replace(",", "")) * (1000 if suffix else 1)


def balance_amount(value: str) -> int:
    if re.fullmatch(r"[0-9]+", value):
        return dust_amount(value + "k")
    if re.fullmatch(r"[0-9]+[dD]", value):
        return dust_amount(value[:-1])
    return dust_amount(value)


def calendar_date(value: str) -> date:
    try:
        result = date.fromisoformat(value)
        if result.isoformat() == value:
            return result
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("enter a valid date in YYYY-MM-DD format")


class DustParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        self.exit(2, f"{decoration('❌ ')}{self.prog}: {message}\n")


def decoration(icon: str) -> str:
    return "" if "--plain" in sys.argv or os.getenv("CLI_PLAIN") == "1" else icon


def main() -> None:
    parser = DustParser(description="Plan daily Fortnite inventory use before season end.")
    parser.add_argument("balance", nargs="?", type=balance_amount,
                        help="positional shorthand for --dust")
    parser.add_argument("end_date", nargs="?", type=calendar_date,
                        help="positional shorthand for --cutoff after a dust balance")
    parser.add_argument("-d", "--dust", type=balance_amount,
                        help="Sprite Dust in thousands, such as 187 or 187k; 187d is exact dust")
    parser.add_argument("-e", "--extractors", type=int, help="number of Portable Extractors")
    parser.add_argument("-a", "--accelerators", type=int, help="number of Extraction Accelerators")
    parser.add_argument("--cutoff", type=calendar_date,
                        help=f"first date after spending ends (YYYY-MM-DD, default: {DEFAULT_CUTOFF})")
    parser.add_argument("--target", type=dust_amount, help="dust to keep at season end (default: 0)")
    parser.add_argument("--as-of", type=calendar_date, default=date.today(), help="first spending date (default: today)")
    parser.add_argument("--plain", action="store_true", help="omit emoji decoration")
    args = parser.parse_args()

    if args.balance is not None and args.dust is not None:
        parser.error("provide the dust balance only once")
    if args.end_date and args.cutoff:
        parser.error("provide the cutoff only once")

    dust = args.dust if args.dust is not None else args.balance
    target = args.target or 0
    if args.target is not None and dust is None:
        parser.error("--target requires a dust balance")
    if dust is not None and target > dust:
        parser.error("end target exceeds the current balance")

    resources = [
        (name, label, balance, reserve) for name, label, balance, reserve in (
            ("Dust", "Dust", dust, target),
            ("Extractors", "Extract", args.extractors, 0),
            ("Accelerators", "Accel", args.accelerators, 0),
        ) if balance is not None
    ]
    if not resources:
        parser.error("provide at least one balance with --dust, --extractors, or --accelerators")
    if any(balance < 0 for _, _, balance, _ in resources):
        parser.error("item counts must be nonnegative")

    cutoff = args.cutoff or args.end_date or DEFAULT_CUTOFF
    days = (cutoff - args.as_of).days
    if days <= 0:
        parser.error("no spending days left; cutoff must be later than the first spending date")

    print(f"{decoration('📅 ')}Spending days: {days} (cutoff {cutoff} at local midnight)")
    separator = decoration("–") or "-"
    single = len(resources) == 1
    columns = []
    budgets = []
    for name, label, balance, reserve in resources:
        daily, extra = divmod(balance - reserve, days)
        rate = f"{daily:,}{separator}{daily + 1:,}" if extra else f"{daily:,}"
        if single:
            print(f"{decoration('📊 ')}Daily budget: {rate} {name.lower()}")
            print(f"{decoration('🎯 ')}End target: {reserve:,}")
            use_label, left_label = "Spend", f"{name} left"
        else:
            print(f"{decoration('📊 ')}{name}: {rate}/day, end target {reserve:,}")
            use_label, left_label = f"{label} use", f"{label} left"
        width = max(len(left_label), len(f"{balance:,}"))
        columns.extend((f"{use_label:>{width}}", f"{left_label:>{width}}"))
        budgets.append((balance, daily, extra, width))

    print()
    print("  ".join(["Date      ", *columns]))
    for offset in range(days):
        row = [str(args.as_of + timedelta(days=offset))]
        for balance, daily, extra, width in budgets:
            spend = daily + (offset < extra)
            left = balance - daily * (offset + 1) - min(offset + 1, extra)
            row.extend((f"{spend:>{width},}", f"{left:>{width},}"))
        print("  ".join(row))


if __name__ == "__main__":
    main()
