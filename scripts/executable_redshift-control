#!/usr/bin/env python3
"""Set or adjust manual Redshift temperature in kelvin."""
import argparse
import fcntl
import os
from pathlib import Path
import subprocess
import sys


def apply(action, value):
    directory = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "redshift"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = directory / "temperature"
        current = int(state.read_text()) if state.exists() else 6500
        if not 1000 <= current <= 6500:
            raise ValueError("Saved temperature must be between 1000 and 6500 K")
        target = 6500 if action == "reset" else value
        if action == "adjust":
            target = max(1000, min(6500, current + value))
        if not 1000 <= target <= 6500:
            raise ValueError("Temperature must be between 1000 and 6500 K")
        subprocess.run(["redshift", "-x"] if action == "reset" else
                       ["redshift", "-P", "-O", str(target)], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        pending = directory / "temperature.tmp"
        pending.write_text(str(target) + "\n")
        pending.replace(state)
        try:
            notification = directory / "notification-id"
            previous = notification.read_text().strip() if notification.exists() else "0"
            if not previous.isascii() or not previous.isdecimal() or int(previous) >= 2**32:
                previous = "0"
            result = subprocess.run(["notify-send", "--print-id", f"--replace-id={previous}",
                            "-a", "Redshift", "-u", "low", "-t", "2000",
                            "-h", "string:x-dunst-stack-tag:redshift-temperature",
                            "🌡️ Redshift", f"{target} K"], check=True, timeout=2,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            identifier = getattr(result, "stdout", "")
            if isinstance(identifier, str) and identifier.strip().isascii() and identifier.strip().isdecimal():
                notification.write_text(identifier.strip() + "\n")
        except (OSError, ValueError, subprocess.SubprocessError):
            pass  # Desktop notification delivery must not undo a successful change.
        return target


def main():
    parser = argparse.ArgumentParser(description="🌡️ Set or adjust Redshift (1000–6500 K).")
    parser.add_argument("action", choices=("set", "adjust", "reset"))
    parser.add_argument("value", type=int, nargs="?", help="Temperature or signed step in kelvin")
    parser.add_argument("--plain", action="store_true", help="Use ASCII output")
    parser.add_argument("--details", action="store_true", help="Show backend diagnostics on failure")
    args = parser.parse_args()
    if (args.action == "reset") != (args.value is None):
        parser.error("set/adjust need a value; reset takes no value")
    try:
        target = apply(args.action, args.value)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(("" if args.plain else "❌ ") + "Redshift failed; check display access and saved temperature.", file=sys.stderr)
        if args.details:
            print(getattr(error, "stderr", b"").decode(errors="replace") or str(error), file=sys.stderr)
        return 1
    print(("" if args.plain else "🌡️ ") + f"Temperature: {target} K")
    return 0


if __name__ == "__main__":
    sys.exit(main())
