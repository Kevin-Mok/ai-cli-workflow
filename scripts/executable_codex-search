#!/usr/bin/env python3
"""Search or browse local Codex conversations through a private incremental cache."""
import argparse
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import unicodedata
from datetime import datetime, timezone

from codex_search_index import (SearchError, cache_lock, cleanup, refresh,
                                search, recent_entries, titles, visible, warn)


def _cli_message(text, icon):
    """Decorate human output; CLI_PLAIN=1 keeps legacy scripts undecorated."""
    import os
    import sys
    plain = os.environ.get('CLI_PLAIN') == '1' or '--plain' in sys.argv
    return ('' if plain else icon + ' ') + text


def resume_args(entry):
    cwd = entry['cwd']
    if not cwd or any(not c.isprintable() for c in cwd) or not Path(cwd).is_absolute() or not Path(cwd).is_dir():
        return None
    return ['codex', 'resume', '-C', cwd, entry['id']]


def cell_width(char):
    if unicodedata.combining(char) or unicodedata.category(char) in ('Mn', 'Me'):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ('W', 'F') else 1


def shorten(text, width, marker='…'):
    if sum(map(cell_width, text)) <= width:
        return text
    marker = marker[:max(0, width)]
    used = 0
    for end, char in enumerate(text):
        used += cell_width(char)
        if used > max(0, width - len(marker)):
            return text[:end] + marker
    return text


def paint(text, color, style):
    return f'\x1b[{style}m{text}\x1b[0m' if color else text


def render_snippet(snippet, color=False, width=None, plain=False):
    # Escape terminal controls while retaining rg's byte-derived match locations.
    parts = [visible(char) for char in snippet['text']]
    offsets = [0]
    for part in parts:
        offsets.append(offsets[-1] + len(part))
    text = ''.join(parts)
    spans = [(offsets[left], offsets[right]) for left, right in snippet['spans']]
    marker = '...' if plain else '…'
    start, end = 0, len(text)
    if width is not None and sum(map(cell_width, text)) > width:
        start = spans[0][0] if spans else 0
        context = 0
        while start > 0 and context + cell_width(text[start - 1]) <= min(30, width // 3):
            start -= 1
            context += cell_width(text[start])
        marker = marker[:max(0, width)]
        budget = max(0, width - (len(marker) if start > 0 else 0) - len(marker))
        end, used = start, 0
        while end < len(text) and used + cell_width(text[end]) <= budget:
            used += cell_width(text[end])
            end += 1
    chunks = [marker] if start else []
    cursor = start
    for left, right in spans:
        left, right = max(left, start), min(right, end)
        if right > left:
            chunks.extend([text[cursor:left], paint(text[left:right], color, '1;33')])
            cursor = right
    chunks.append(text[cursor:end])
    if end < len(text):
        chunks.append(marker)
    return ''.join(chunks)


def display_date(value):
    try:
        stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))
        if stamp.tzinfo is None:
            stamp = stamp.replace(tzinfo=timezone.utc)
        return stamp.astimezone(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')
    except (ValueError, OverflowError):
        return '(date unknown)'


def print_results(results, names, args):
    terminal = sys.stdout.isatty()
    compact = terminal and not args.details
    plain = getattr(args, 'plain', False) or os.environ.get('CLI_PLAIN') == '1'
    marker = '...' if plain else '…'
    separator = ' | ' if plain else ' · '
    color = terminal and not plain and not os.environ.get('NO_COLOR') and os.environ.get('TERM') != 'dumb'
    try:
        width = os.get_terminal_size(sys.stdout.fileno()).columns
    except OSError:
        width = 100
    limit = args.limit if args.limit is not None else 20 if terminal else 0
    shown = results[:limit] if limit else results
    if len(shown) < len(results):
        order = 'AI priority first' if getattr(args, 'sort', None) == 'priority' else 'newest first'
        warn(f'showing {len(shown)} of {len(results)} matches, {order}; '
             '--limit 0 shows all; --pick browses all')
    for number, (entry, snippets) in enumerate(shown, 1):
        sid = entry['id']
        if compact:
            directory = entry['cwd'] or '(directory not recorded)'
            home = str(Path.home())
            if directory == home or directory.startswith(home + os.sep):
                directory = '~' + directory[len(home):]
            prefix = f'{number:02d}  ' + ('' if plain else '📁 ')
            date = display_date(entry['timestamp'])
            if width < len(prefix) + len(date) + 15:
                print(paint(prefix + shorten(visible(directory), max(1, width - len(prefix)), marker), color, '1;36'))
                print('    ' + paint(shorten(date, max(1, width - 4), marker), color, '2'))
            else:
                path_width = width - len(prefix) - len(date) - 3
                print(paint(prefix + shorten(visible(directory), path_width, marker), color, '1;36') +
                      separator + paint(date, color, '2'))
            if names.get(sid):
                print('    ' + paint(shorten(visible(names[sid]), max(1, width - 4), marker), color, '1'))
            for snippet in snippets[:1]:
                print('    ' + render_snippet(snippet, color, max(1, width - 4), plain))
        else:
            print(('' if plain else '💬 ') + 'Title: ' + visible(names.get(sid, '(untitled)')))
            print(('' if plain else '🕒 ') + 'Timestamp: ' + visible(entry['timestamp'] or '(unknown)'))
            print(('' if plain else '📁 ') + 'Directory: ' + visible(entry['cwd'] or '(not recorded)'))
            print(('' if plain else '🧾 ') + 'Session: ' + sid)
            for snippet in snippets:
                print('  ' + render_snippet(snippet, color, plain=plain))
        command = resume_args(entry)
        if command:
            print(paint((('    -> ' if plain else '    ↳ ') if compact else 'Resume: ') + shlex.join(command), color, '2'))
        else:
            print('Resume unavailable: recorded directory is missing or invalid')
        print()


def print_recent(results, names, args, manager):
    """Reuse ordinary output formatting with a cached recap instead of a match."""
    if args.limit is None:
        args.limit = 20
    from codex_search_recent import order_sessions, priority_value
    statuses = {entry['id']: manager.status(entry) for entry, _ in results}
    entries = order_sessions([entry for entry, _ in results], statuses, args.sort or 'recent')
    rendered = []
    for entry in entries:
        status = statuses[entry['id']]
        label = status['status']
        if status['partial']:
            label += ', partial'
        headline = status['recap']['headline'] if status['recap'] else 'No cached AI recap'
        priority = priority_value(status, current_only=True)
        separator = ' | ' if args.plain else ' · '
        detail = f'Priority [{priority}]' + separator + f'Recap [{label}]: {headline}'
        if args.details:
            recap = status['recap'] or {}
            reason = recap.get('priority_reason') or 'No current AI priority evidence.'
            prior = recap.get('priority')
            if prior and status['status'] != 'ready':
                reason = f'Older {prior} priority: ' + reason
            detail += separator + 'Reason: ' + reason
        rendered.append((entry, [{'text': detail, 'spans': []}]))
    print_results(rendered, names, args)


def pick(results, names):
    rows = []
    by_id = {}
    for entry, snippets in results:
        sid = entry['id']
        by_id[sid] = entry
        rows.append('\t'.join([sid, visible(entry['timestamp']), visible(names.get(sid, '(untitled)')),
                               visible(entry['cwd'] or '(not recorded)'), visible(snippets[0]['text'] if snippets else '')]))
    env = dict(os.environ)
    # A user default --bind/--multi must not execute another action or add selections.
    env.pop('FZF_DEFAULT_OPTS', None)
    env.pop('FZF_DEFAULT_OPTS_FILE', None)
    result = subprocess.run(['fzf', '--no-multi', '--delimiter=\t', '--with-nth=2..',
                             '--prompt=Resume Codex> ', '--header=Enter resumes; Esc cancels'],
                            input='\n'.join(rows) + '\n', text=True, stdout=subprocess.PIPE, env=env)
    if result.returncode in (1, 130):
        return 0
    if result.returncode != 0:
        raise SearchError(f'fzf failed (exit {result.returncode}); see its terminal error above')
    selected = result.stdout.rstrip('\n')
    if selected not in rows:
        raise SearchError('fzf returned an invalid selection; nothing was launched')
    entry = by_id[selected.split('\t', 1)[0]]
    command = resume_args(entry)
    if command is None:
        raise SearchError('cannot resume: recorded directory is missing or invalid; restore it before resuming')
    os.execvp('codex', command)


def parser():
    result = argparse.ArgumentParser(
        prog='codex-search',
        usage='%(prog)s [-i] [-F] [--all-text] [--pick] [--details] [--limit N] PATTERN\n'
              '       %(prog)s --recent [--pick] [--sort priority|recent] [--limit N] [--no-summaries]\n'
              '       %(prog)s (--rebuild-index | --clear-cache)\n'
              '       %(prog)s --help',
        description=_cli_message('Search local Codex user messages and assistant replies across projects.\n'
                    'Terminal: newest 20 matches with a short highlighted excerpt.\n'
                    'Pipes: all matches with full metadata. The private cache refreshes automatically.', '🧰'),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Examples:\n'
               '  codex-search "cache.*refresh"\n'
               '  codex-search -iF "café"\n'
               '  codex-search --all-text -F "tool output"\n'
               '  codex-search --pick "bug"\n'
               '  codex-search --recent\n'
               '  codex-search --recent --pick\n'
               '  codex-search --recent --pick --no-summaries\n'
               '  codex-search --recent --pick --summary-count 5 --summary-model MODEL\n'
               '  codex-search --details --limit 0 "root"\n'
               '  codex-search -- "-flag"\n\n'
               'Requires Python 3 and rg; --pick also needs fzf. No sudo to run.\n'
               'CODEX_HOME selects sessions; XDG_CACHE_HOME selects cache storage.\n'
               'Guide: ~/linux-config/docs/codex-session-search.md\n'
               'Smoke tests: ~/linux-config/docs/smoke-tests.md#codex-session-search')
    result.add_argument('pattern', nargs='?', help='rg regex (use -- before patterns beginning with -)')
    result.add_argument('-i', '--ignore-case', action='store_true', help='ignore case when matching')
    result.add_argument('-F', '--fixed-strings', action='store_true', help='match literal text instead of a regex')
    result.add_argument('--all-text', action='store_true', help='also search decoded tool calls and output')
    result.add_argument('--pick', action='store_true', help='select with fzf and resume; Esc launches nothing')
    result.add_argument('--details', action='store_true', help='show full metadata and up to five snippets per match')
    result.add_argument('--limit', type=int, metavar='N', help='max results to print; 0 means all (default: 20 in terminal, all in pipes); picker always sees all')
    result.add_argument('--recent', action='store_true', help='browse sessions by activity without a pattern; default newest 20, including pipes')
    result.add_argument('--plain', action='store_true', help='use ASCII decoration and disable color')
    result.add_argument('--sort', choices=('priority', 'recent'), help='recent-mode order: AI priority by default in picker; newest activity in listings')
    result.add_argument('--summary-model', metavar='MODEL', help='override the configured model for recent-session recaps')
    result.add_argument('--summary-count', type=int, default=20, metavar='N', help='automatically recap newest N sessions in recent picker (default: 20); 0 disables automatic work')
    result.add_argument('--no-summaries', action='store_true', help='prohibit all model calls, including Ctrl-G; keep cached recaps and local previews')
    maintenance = result.add_mutually_exclusive_group()
    maintenance.add_argument('--rebuild-index', action='store_true', help='reparse all sources (optionally search afterward)')
    maintenance.add_argument('--clear-cache', action='store_true', help='remove this Codex home cache; leave its lock and sessions intact')
    return result


def main():
    cli = parser()
    args = cli.parse_args()
    args.plain = args.plain or os.environ.get('CLI_PLAIN') == '1'
    if args.limit is not None and args.limit < 0:
        cli.error('--limit must be 0 (all) or a positive integer')
    if args.summary_count < 0:
        cli.error('--summary-count must be 0 or a positive integer')
    if args.summary_model is not None and not args.summary_model.strip():
        cli.error('--summary-model must not be empty')
    if args.recent and args.pattern is not None:
        cli.error('--recent cannot be combined with a search pattern')
    if args.sort is not None and not args.recent:
        cli.error('--sort requires --recent')
    if not args.recent and (args.summary_model or args.no_summaries or args.summary_count != 20):
        cli.error('summary options require --recent')
    if args.clear_cache and (args.pattern is not None or args.pick or args.recent):
        cli.error('--clear-cache cannot be combined with a search or --pick')
    if args.pattern is None and not (args.rebuild_index or args.clear_cache or args.recent):
        if len(sys.argv) > 1:
            cli.error('a search pattern is required')
        # Keep the no-argument surface concise and readable, with a capitalized heading.
        print(cli.format_help().replace('usage:', 'Usage:', 1))
        return 0
    if args.pick and args.pattern is None and not args.recent:
        cli.error('--pick requires a search pattern')
    if args.pattern is not None and not shutil.which('rg'):
        raise SearchError('install ripgrep (rg) to search, for example: sudo apt install ripgrep')
    if args.pick and not shutil.which('fzf'):
        raise SearchError('install fzf to use --pick, for example: sudo apt install fzf; ordinary search works without it')
    home = Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex').expanduser().resolve()
    fast_recent = args.recent and args.pick and not args.rebuild_index
    if fast_recent:
        from codex_search_index import initial_recent, prepare_cache
        root = prepare_cache(home)
        results = recent_entries(initial_recent(root, home))
        names = titles(home, details=False, max_bytes=1024 * 1024)
    else:
        with cache_lock(home) as root:
            from codex_search_recaps import maintain_cache
            if args.clear_cache:
                maintain_cache(root, set(), clear=True)
                cleanup(root)
                warn('cache cleared for ' + str(home))
                return 0
            entries = refresh(root, home, args.rebuild_index)
            maintain_cache(root, {entry['id'] for entry in entries.values() if entry['id']})
            if args.pattern is None and not args.recent:
                return 0
            results = recent_entries(entries) if args.recent else search(root, entries, args)
            names = titles(home)
    # Never retain the cache lock across an interactive picker or resumed Codex process.
    if not results and not fast_recent:
        return 1
    if args.recent:
        from codex_search_recaps import SummaryManager
        manager = SummaryManager(root, home, args.summary_model, count=args.summary_count,
                                 enabled=args.pick and not args.no_summaries)
        manager.plain = args.plain
        manager.details = args.details
        if args.pick:
            from codex_search_recent import pick_recent
            entry = pick_recent(results, names, root, manager, sort=args.sort or 'priority')
            if entry is None:
                return 0
            command = resume_args(entry)
            if command is None:
                raise SearchError('cannot resume: recorded directory is missing or invalid; restore it before resuming')
            os.execvp('codex', command)
        print_recent(results, names, args, manager)
        return 0
    if args.pick:
        return pick(results, names)
    print_results(results, names, args)
    return 0


if __name__ == '__main__':
    try:
        code = main()
        sys.stdout.flush()
        sys.exit(code)
    except BrokenPipeError:
        # Redirect the final interpreter flush too when a consumer closes early.
        with open(os.devnull, 'w') as sink:
            os.dup2(sink.fileno(), sys.stdout.fileno())
        sys.exit(0)
    except (SearchError, OSError) as error:
        warn(str(error))
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
