#!/usr/bin/env bash

# Human-facing decoration; keep protocol/data output unchanged.
cli_emoji() {
  [ "${CLI_PLAIN:-0}" = 1 ] || printf '%s ' "$1"
}
set -euo pipefail

usage() {
  printf '%s' "$(cli_emoji '📖')"
  cat <<'USAGE'
Usage: sync-superpowers-release [--dry-run]

Superpowers installation is disabled by the approved skill cull.
This compatibility command leaves existing upstream files untouched.

Options:
  --dry-run, -n   Report the disabled integration without writing files.
  --help, -h      Show this help.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n)
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "$(cli_emoji '❌')sync-superpowers-release: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

echo "$(cli_emoji 'ℹ️')Superpowers installation is disabled; existing upstream files are unchanged."
