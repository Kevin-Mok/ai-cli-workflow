#!/usr/bin/env bash

# Human-facing decoration; keep protocol/data output unchanged.
cli_emoji() {
  [ "${CLI_PLAIN:-0}" = 1 ] || printf '%s ' "$1"
}

set -euo pipefail

os_release_file="${CHATGPT_INSTALL_OS_RELEASE_FILE:-/etc/os-release}"
architecture="${CHATGPT_INSTALL_ARCHITECTURE:-$(uname -m)}"

if [ ! -r "$os_release_file" ]; then
  printf '%sCannot read OS release metadata: %s\n' "$(cli_emoji 'ℹ️')" "$os_release_file" >&2
  exit 1
fi

# shellcheck disable=SC1090
. "$os_release_file"

case "${ID:-}" in
  ubuntu)
    case "${VERSION_ID:-}" in
      24.04|26.04) package_format="deb" ;;
      *)
        printf '%sUnsupported Ubuntu version: %s (supported: 24.04, 26.04)\n' "$(cli_emoji '❌')" "${VERSION_ID:-unknown}" >&2
        exit 1
        ;;
    esac
    package_manager="apt"
    ;;
  debian)
    if [ "${VERSION_ID:-}" != "13" ]; then
      printf '%sUnsupported Debian version: %s (supported: 13)\n' "$(cli_emoji '❌')" "${VERSION_ID:-unknown}" >&2
      exit 1
    fi
    package_format="deb"
    package_manager="apt"
    ;;
  fedora)
    case "${VERSION_ID:-}" in
      43|44) package_format="rpm" ;;
      *)
        printf '%sUnsupported Fedora version: %s (supported: 43, 44)\n' "$(cli_emoji '❌')" "${VERSION_ID:-unknown}" >&2
        exit 1
        ;;
    esac
    package_manager="dnf"
    ;;
  *)
    printf '%sUnsupported distribution: %s (supported: Ubuntu, Debian, Fedora)\n' "$(cli_emoji '❌')" "${ID:-unknown}" >&2
    exit 1
    ;;
esac

case "$architecture" in
  x86_64)
    deb_package="chatgpt_amd64.deb"
    rpm_package="chatgpt.x86_64.rpm"
    ;;
  aarch64|arm64)
    deb_package="chatgpt_arm64.deb"
    rpm_package="chatgpt.aarch64.rpm"
    ;;
  *)
    printf '%sUnsupported processor architecture: %s (supported: x86_64, aarch64, arm64)\n' "$(cli_emoji '❌')" "$architecture" >&2
    exit 1
    ;;
esac

case "$package_format" in
  deb)
    package_name="$deb_package"
    package_url="https://persistent.oaistatic.com/codex-app-prod/linux/deb/latest/${package_name}"
    ;;
  rpm)
    package_name="$rpm_package"
    package_url="https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/${package_name}"
    ;;
esac

for command_name in curl sudo "$package_manager"; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf '%sRequired command is unavailable: %s\n' "$(cli_emoji '❌')" "$command_name" >&2
    exit 1
  fi
done

temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/chatgpt-install.XXXXXX")"
trap 'rm -rf "$temporary_directory"' EXIT
package_path="${temporary_directory}/${package_name}"

printf '%sDownloading ChatGPT desktop app: %s\n' "$(cli_emoji 'ℹ️')" "$package_url"
curl --fail --location --retry 3 --output "$package_path" "$package_url"
chmod 711 "$temporary_directory"
chmod 644 "$package_path"

printf '%sInstalling ChatGPT desktop app with sudo %s.\n' "$(cli_emoji 'ℹ️')" "$package_manager"
sudo "$package_manager" install "$package_path"
