#!/usr/bin/env python3
"""Toggle speaker mute and replace the desktop audio popup in place."""
import argparse
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys


def toggle():
    directory = Path(os.environ.get('XDG_RUNTIME_DIR', str(Path.home() / '.cache'))) / 'audio-mute'
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (directory / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        result = subprocess.run(['amixer', '-D', 'pulse', 'sset', 'Master', 'toggle'],
                                check=True, capture_output=True, text=True, timeout=5)
        switches = re.findall(r'\[(on|off)\]', result.stdout)
        if not switches:
            raise ValueError('Mixer did not report a mute state')
        status = 'Muted' if all(switch == 'off' for switch in switches) else 'Unmuted'
        for command in (
            ['pkill', '-RTMIN+1', 'i3blocks'],
            ['notify-send', '-a', 'Audio', '-u', 'low', '-t', '2000',
             '-h', 'string:x-dunst-stack-tag:audio-mute',
             '🔇 Audio' if status == 'Muted' else '🔊 Audio', status],
        ):
            try:
                subprocess.run(command, check=True, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=2)
            except (OSError, subprocess.SubprocessError):
                pass  # Desktop feedback must not fail a successful audio toggle.
        return status


def main():
    parser = argparse.ArgumentParser(description='🔊 Toggle speaker mute with an in-place desktop popup.')
    parser.add_argument('--plain', action='store_true', help='Use ASCII output')
    parser.add_argument('--details', action='store_true', help='Show backend diagnostics on failure')
    args = parser.parse_args()
    try:
        status = toggle()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(('' if args.plain else '❌ ') + 'Mute toggle failed; check audio access.', file=sys.stderr)
        if args.details:
            print(getattr(error, 'stderr', None) or str(error), file=sys.stderr)
        return 1
    print(('' if args.plain else '🔊 ') + status)
    return 0


if __name__ == '__main__':
    sys.exit(main())
