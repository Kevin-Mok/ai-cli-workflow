#!/usr/bin/env python3
"""Apply deterministic, non-reporting redactions to a Git tree or message."""

from __future__ import annotations

import argparse
import base64
import fnmatch
import ipaddress
import json
import os
from pathlib import Path
import re
import shutil
import sys


EMAIL_RE = re.compile(rb"(?i)(?<![\w.+-])([a-z0-9.!#$%&'*+/?^_`{|}~-]+)@([a-z0-9.-]+\.[a-z]{2,})(?![\w.-])")
HOME_RE = re.compile(rb"(?<![\w/])/home/[a-z_][a-z0-9_-]{0,31}(?=/|\b)", re.I)
IPV4_RE = re.compile(rb"(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])")
PRIVATE_KEY_LABEL_RE = rb"[A-Z0-9 ]*" + rb"PRIVATE " + rb"KEY"
PEM_BLOCK_RE = re.compile(
    rb"-----BEGIN (" + PRIVATE_KEY_LABEL_RE + rb")-----.*?-----END \1-----",
    re.DOTALL,
)
PEM_HEADER_RE = re.compile(rb"-----BEGIN " + PRIVATE_KEY_LABEL_RE + rb"-----")
BASE64_RE = re.compile(rb"(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{32,}={0,2}(?![A-Za-z0-9+/=])")
CREDENTIAL_RE = re.compile(
    rb"(?im)(\b(?:api[_-]?(?:key|token)|access[_-]?key|auth[_-]?token|client[_-]?secret|password|passwd|refresh[_-]?token|secret[_-]?key)\b\s*[:=]\s*[\"']?)([^\s\"'#,;]{8,})"
)
URL_USERINFO_RE = re.compile(
    rb"(?i)\b(https?|ssh)://[^\s/@:]+(?::[^\s/@]*)?@([a-z0-9.-]+(?::\d+)?)"
)

SAFE_EMAIL_DOMAINS = {
    b"example.com",
    b"example.invalid",
    b"noreply.github.com",
    b"users.noreply.github.com",
}
SAFE_VALUE_MARKERS = (
    b"example",
    b"placeholder",
    b"redacted",
    b"changeme",
    b"dummy",
    b"<",
    b"${",
    b"{{",
    b"test-fixture",
)
DOCUMENTATION_NETWORKS = (
    ipaddress.ip_network("192.0.2.0/24"),
    ipaddress.ip_network("198.51.100.0/24"),
    ipaddress.ip_network("203.0.113.0/24"),
)


class SanitizeError(RuntimeError):
    """Raised when sanitization cannot be completed safely."""


def load_rules(path: Path) -> dict[str, object]:
    try:
        mode = path.stat().st_mode & 0o777
    except OSError as error:
        raise SanitizeError("Private rule file is unavailable") from error
    if mode & 0o077:
        raise SanitizeError("Private rule file must have mode 0600")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise SanitizeError("Private rule file is invalid") from error
    if not isinstance(payload, dict):
        raise SanitizeError("Private rule file must contain an object")
    drops = payload.get("drop_globs", [])
    replacements = payload.get("replace_literals", [])
    renames = payload.get("rename_paths", {})
    if not isinstance(drops, list) or not all(
        isinstance(pattern, str) and pattern for pattern in drops
    ):
        raise SanitizeError("Private drop rules are invalid")
    if not isinstance(replacements, list):
        raise SanitizeError("Private replacement rules are invalid")
    parsed_replacements: list[tuple[bytes, bytes, bool]] = []
    for item in replacements:
        if not isinstance(item, dict):
            raise SanitizeError("Private replacement rule is invalid")
        value = item.get("value")
        replacement = item.get("replacement")
        ignore_case = item.get("ignore_case", False)
        if (
            not isinstance(value, str)
            or not value
            or not isinstance(replacement, str)
            or not isinstance(ignore_case, bool)
        ):
            raise SanitizeError("Private replacement rule is incomplete")
        parsed_replacements.append(
            (
                value.encode("utf-8"),
                replacement.encode("utf-8"),
                ignore_case,
            )
        )
    if not isinstance(renames, dict) or not all(
        isinstance(source, str)
        and source
        and isinstance(destination, str)
        and destination
        for source, destination in renames.items()
    ):
        raise SanitizeError("Private rename rules are invalid")
    return {
        "drop_globs": tuple(drops),
        "replace_literals": tuple(parsed_replacements),
        "rename_paths": dict(renames),
    }


def redact_email(match: re.Match[bytes]) -> bytes:
    domain = match.group(2).lower()
    if domain in SAFE_EMAIL_DOMAINS:
        return match.group(0)
    return b"user@example.invalid"


def redact_ip(match: re.Match[bytes]) -> bytes:
    try:
        address = ipaddress.ip_address(match.group(0).decode("ascii"))
    except ValueError:
        return match.group(0)
    if (
        address.is_loopback
        or address.is_unspecified
        or any(address in network for network in DOCUMENTATION_NETWORKS)
    ):
        return match.group(0)
    return b"192.0.2.10"


def redact_credential(match: re.Match[bytes]) -> bytes:
    if any(marker in match.group(2).lower() for marker in SAFE_VALUE_MARKERS):
        return match.group(0)
    return match.group(1) + b"<redacted>"


def redact_encoded_key(match: re.Match[bytes]) -> bytes:
    try:
        decoded = base64.b64decode(match.group(0), validate=True)
    except (ValueError, base64.binascii.Error):
        return match.group(0)
    if PEM_HEADER_RE.search(decoded):
        return b"<private-key-removed>"
    return match.group(0)


def sanitize_bytes(
    content: bytes, replacements: tuple[tuple[bytes, bytes, bool], ...]
) -> bytes:
    sanitized = content
    for value, replacement, ignore_case in replacements:
        if ignore_case:
            sanitized = re.sub(re.escape(value), replacement, sanitized, flags=re.I)
        else:
            sanitized = sanitized.replace(value, replacement)
    sanitized = PEM_BLOCK_RE.sub(b"<private-key-removed>", sanitized)
    sanitized = BASE64_RE.sub(redact_encoded_key, sanitized)
    sanitized = CREDENTIAL_RE.sub(redact_credential, sanitized)
    sanitized = EMAIL_RE.sub(redact_email, sanitized)
    sanitized = HOME_RE.sub(b"/home/example", sanitized)
    sanitized = IPV4_RE.sub(redact_ip, sanitized)
    sanitized = URL_USERINFO_RE.sub(lambda match: match.group(1) + b"://" + match.group(2), sanitized)
    return sanitized


def relative_name(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def tree_paths(root: Path) -> list[Path]:
    paths: list[Path] = []
    for current, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        current_path = Path(current)
        if current_path == root:
            directory_names[:] = [name for name in directory_names if name != ".git"]
        paths.extend(current_path / name for name in directory_names)
        paths.extend(current_path / name for name in file_names)
    return paths


def apply_tree(root: Path, rules: dict[str, object]) -> None:
    drops = rules["drop_globs"]
    replacements = rules["replace_literals"]
    renames = rules["rename_paths"]
    assert isinstance(drops, tuple)
    assert isinstance(replacements, tuple)
    assert isinstance(renames, dict)

    for source_name, destination_name in sorted(renames.items()):
        source = root / source_name
        if not source.exists() and not source.is_symlink():
            continue
        destination = root / destination_name
        destination.parent.mkdir(parents=True, exist_ok=True)
        if destination.exists() or destination.is_symlink():
            raise SanitizeError("Rename destination already exists")
        source.rename(destination)

    paths = sorted(tree_paths(root), key=lambda path: len(path.parts), reverse=True)
    for path in paths:
        name = relative_name(path, root)
        if any(fnmatch.fnmatchcase(name, pattern) for pattern in drops):
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            else:
                path.unlink(missing_ok=True)

    for path in sorted(tree_paths(root)):
        if path.is_dir():
            continue
        if path.is_symlink():
            target = os.readlink(path).encode("utf-8", errors="surrogateescape")
            sanitized_target = sanitize_bytes(target, replacements)
            if sanitized_target != target:
                path.unlink()
                os.symlink(
                    sanitized_target.decode("utf-8", errors="surrogateescape"), path
                )
            continue
        content = path.read_bytes()
        if b"\0" in content:
            continue
        sanitized = sanitize_bytes(content, replacements)
        if sanitized != content:
            path.write_bytes(sanitized)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Sanitize a checked-out Git tree or commit message."
    )
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--root", type=Path)
    mode.add_argument("--message", action="store_true")
    parser.add_argument("--rules", type=Path, required=True)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        rules = load_rules(args.rules.resolve())
        if args.message:
            replacements = rules["replace_literals"]
            assert isinstance(replacements, tuple)
            sys.stdout.buffer.write(sanitize_bytes(sys.stdin.buffer.read(), replacements))
        else:
            root = args.root.resolve()
            if not root.is_dir():
                raise SanitizeError("Sanitization root is not a directory")
            apply_tree(root, rules)
    except (OSError, SanitizeError) as error:
        print(f"❌ ERROR: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
