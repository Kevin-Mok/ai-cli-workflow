#!/usr/bin/env python3
"""Download one YouTube video at yt-dlp's best available quality with audio."""
import argparse
from pathlib import Path
import re
import shutil
import subprocess
import sys
from urllib.parse import parse_qs, urlsplit


def video_url(value):
    """Accept video links only and discard playlist/tracking parameters."""
    try:
        url = urlsplit(value)
        host = url.hostname
        video_id = ''
        if url.scheme not in ('https', 'http') or url.username or url.password:
            raise ValueError
        if host == 'youtu.be':
            video_id = url.path.removeprefix('/')
        elif host in ('youtube.com', 'www.youtube.com', 'm.youtube.com', 'music.youtube.com'):
            if url.path == '/watch':
                video_id = parse_qs(url.query).get('v', [''])[0]
            elif re.fullmatch(r'/(shorts|live|embed)/[\w-]{11}', url.path):
                video_id = url.path.rsplit('/', 1)[1]
        if not re.fullmatch(r'[A-Za-z0-9_-]{11}', video_id):
            raise ValueError
    except ValueError:
        raise argparse.ArgumentTypeError('expected a YouTube video URL with an 11-character video ID') from None
    return f'https://www.youtube.com/watch?v={video_id}'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('url', type=video_url)
    parser.add_argument('-o', '--output-dir', type=Path,
                        default=Path.home() / 'Downloads' / 'yt-dl',
                        help='destination directory (default: ~/Downloads/yt-dl)')
    args = parser.parse_args()
    for dependency in ('yt-dlp', 'ffmpeg'):
        if not shutil.which(dependency):
            print(f'yt-dl: missing {dependency}; install it and ensure it is on PATH', file=sys.stderr)
            return 1
    try:
        output = args.output_dir.expanduser().resolve()
        output.mkdir(parents=True, exist_ok=True)
        result = subprocess.run([
            'yt-dlp', '--ignore-config', '--no-playlist', '--no-overwrites',
            '--no-simulate', '--write-info-json', '--no-progress',
            '--socket-timeout', '30', '--retries', '3',
            '--format', 'bv*+ba/b',
            '--merge-output-format', 'mkv', '--paths', str(output),
            '--output', '%(id)s.%(ext)s', '--print', 'after_move:filepath',
            '--', args.url,
        ], stdout=subprocess.PIPE, text=True)
        if result.returncode:
            print('yt-dl: download failed; see yt-dlp diagnostics above', file=sys.stderr)
            return result.returncode if result.returncode > 0 else 128 - result.returncode
        paths = result.stdout.strip().splitlines()
        if len(paths) != 1:
            raise ValueError('downloader did not report exactly one completed file')
        artifact = Path(paths[0]).resolve()
        if artifact.parent != output or not artifact.is_file() or artifact.stat().st_size == 0:
            raise ValueError('downloader reported a missing, empty, or unexpected output file')
        print(artifact)
        return 0
    except (OSError, ValueError) as error:
        print(f'yt-dl: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
