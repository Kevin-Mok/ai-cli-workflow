#!/usr/bin/env python3
"""Report the retired Superpowers integration or explicitly disable its old timer."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from typing import Sequence


TIMER_NAME = "superpowers-release-sync.timer"


def _cli_message(text: str, icon: str) -> str:
    return ("" if os.environ.get("CLI_PLAIN") == "1" else icon + " ") + text


class TimerSetupError(RuntimeError):
    """An explicit legacy timer cleanup could not complete."""


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="setup-superpowers-release-timer",
        description=_cli_message("Superpowers installation is disabled; clean up its legacy timer.", "🧰"),
    )
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true", help="Report the disabled repo integration; does not inspect live timers.")
    action.add_argument("--enable", action="store_true", help="Retired; enabling is refused.")
    action.add_argument("--disable", action="store_true", help="Disable an existing legacy timer.")
    return parser


def _disable() -> None:
    try:
        completed = subprocess.run(
            ("systemctl", "--user", "disable", "--now", TIMER_NAME),
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as error:
        raise TimerSetupError("timer disable failed") from error
    output = f"{completed.stdout}\n{completed.stderr}".casefold()
    if completed.returncode != 0 and "is not loaded" not in output:
        raise TimerSetupError("timer disable failed")
    print(_cli_message("Superpowers release timer disabled.", "⏱️"))


def main(argv: Sequence[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.enable:
            raise TimerSetupError("Superpowers installation is disabled; use --disable to stop its legacy timer")
        if args.disable:
            _disable()
        else:
            print(_cli_message("Superpowers repo integration is disabled; existing timers are not inspected.", "ℹ️"))
    except TimerSetupError as error:
        print(_cli_message(f"setup-superpowers-release-timer: {error}", "❌"), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
