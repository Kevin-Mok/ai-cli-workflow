#!/usr/bin/env python3
"""Download one YouTube video at yt-dlp's best available quality with audio."""
import argparse
from fractions import Fraction
import json
import math
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from urllib.parse import parse_qs, urlsplit


def video_url(value):
    """Accept video links only and discard playlist/tracking parameters."""
    try:
        url = urlsplit(value)
        host = url.hostname
        video_id = ''
        if url.scheme not in ('https', 'http') or url.username or url.password:
            raise ValueError
        if host == 'youtu.be':
            video_id = url.path.removeprefix('/')
        elif host in ('youtube.com', 'www.youtube.com', 'm.youtube.com', 'music.youtube.com'):
            if url.path == '/watch':
                video_id = parse_qs(url.query).get('v', [''])[0]
            elif re.fullmatch(r'/(shorts|live|embed)/[\w-]{11}', url.path):
                video_id = url.path.rsplit('/', 1)[1]
        if not re.fullmatch(r'[A-Za-z0-9_-]{11}', video_id):
            raise ValueError
    except ValueError:
        raise argparse.ArgumentTypeError('expected a YouTube video URL with an 11-character video ID') from None
    return f'https://www.youtube.com/watch?v={video_id}'


def download_stem(title):
    normalized = unicodedata.normalize('NFKD', title).encode('ascii', 'ignore').decode()
    slug = re.sub(r'[^a-z0-9]+', '-', normalized.lower()).strip('-')[:160].rstrip('-')
    return slug or 'video'


def fetch_metadata(url, runtime):
    result = subprocess.run([
        'yt-dlp', '--ignore-config', '--no-playlist', *runtime,
        '--socket-timeout', '30', '--retries', '3',
        '--skip-download', '--dump-single-json', '--', url,
    ], capture_output=True, text=True, timeout=180)
    if result.stderr:
        print(result.stderr, end='', file=sys.stderr)
    if result.returncode or 'WARNING:' in result.stderr:
        raise ValueError('metadata extraction failed or warned; update yt-dlp and check its runtime')
    info = json.loads(result.stdout)
    if info['id'] != parse_qs(urlsplit(url).query)['v'][0]:
        raise ValueError('metadata video ID mismatch')
    return info


def video_rank(width, height, fps):
    """Rank resolution orientation-independently, then frame rate."""
    width, height, fps = int(width), int(height), float(fps)
    if min(width, height) <= 0 or not math.isfinite(fps) or fps <= 0:
        raise ValueError('missing or invalid video dimensions/frame rate')
    return min(width, height), fps


def verify_quality(artifact, url, runtime):
    """Check actual media against fresh formats, never a stale sidecar."""
    probe = subprocess.run([
        'ffprobe', '-v', 'error', '-show_streams', '-of', 'json', str(artifact),
    ], capture_output=True, text=True, timeout=60)
    if probe.returncode:
        raise ValueError(f'quality check: ffprobe failed: {probe.stderr.strip()}')
    streams = json.loads(probe.stdout)['streams']
    videos = [s for s in streams if s.get('codec_type') == 'video'
              and not s.get('disposition', {}).get('attached_pic')]
    if not videos or not any(s.get('codec_type') == 'audio' for s in streams):
        raise ValueError('quality check: downloaded file lacks video or audio')
    video = videos[0]
    actual = video_rank(video['width'], video['height'],
                        Fraction(video['avg_frame_rate']))
    info = fetch_metadata(url, runtime)
    candidates = [f for f in info['formats']
                  if f.get('vcodec') not in (None, 'none')
                  and f.get('url') and not f.get('has_drm')]
    if not candidates:
        raise ValueError('quality check: no available video formats reported')
    best = max(video_rank(f['width'], f['height'], f['fps']) for f in candidates)
    # Nominal source FPS can differ slightly from muxed/variable-rate timing.
    fps_tolerance = best[1] * 0.01
    if actual[0] < best[0] or (actual[0] == best[0] and actual[1] < best[1] - fps_tolerance):
        raise ValueError(
            f'quality check FAILED: saved {actual[0]}p at {actual[1]:g} fps; '
            f'highest reported is {best[0]}p at {best[1]:g} fps. '
            'File retained; use -o with a fresh directory to download the higher quality.')
    four_k = '4K or higher verified' if max(video['width'], video['height']) >= 3840 else '4K not reported by yt-dlp'
    print(f'yt-dl: VERIFIED {video["width"]}x{video["height"]} at {actual[1]:g} fps '
          f'with audio; highest reported resolution/frame rate; {four_k}.', file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('url', type=video_url)
    parser.add_argument('-o', '--output-dir', type=Path,
                        default=Path('/mnt/linux-files-3/yt-vids'),
                        help='destination directory (default: /mnt/linux-files-3/yt-vids)')
    args = parser.parse_args()
    for dependency in ('yt-dlp', 'ffmpeg', 'ffprobe'):
        if not shutil.which(dependency):
            print(f'yt-dl: missing {dependency}; install it and ensure it is on PATH', file=sys.stderr)
            return 1
    runtime = ['--js-runtimes', 'node'] if shutil.which('node') else []
    try:
        output = args.output_dir.expanduser().resolve()
        output.mkdir(parents=True, exist_ok=True)
        print('yt-dl: Fetching video information and starting download...',
              file=sys.stderr, flush=True)
        info = fetch_metadata(args.url, runtime)
        stem = download_stem(info['title'])
        with tempfile.TemporaryDirectory(prefix='yt-dl-report-') as report_dir:
            report = Path(report_dir) / 'filepath.txt'
            result = subprocess.run([
                'yt-dlp', '--ignore-config', '--no-playlist', '--no-overwrites', *runtime,
                '--no-simulate', '--no-write-info-json', '--quiet', '--progress',
                '--socket-timeout', '30', '--retries', '3',
                '--format', 'bv*+ba/b', '--format-sort', 'res,fps', '--format-sort-force',
                '--merge-output-format', 'mkv', '--paths', str(output),
                '--output', stem + '.%(ext)s',
                '--print-to-file', 'after_move:filepath', str(report),
                '--', args.url,
            ], stdout=sys.stderr, text=True)
            paths = report.read_text().strip().splitlines() if report.exists() else []
        if result.returncode:
            print('yt-dl: download failed; see yt-dlp diagnostics above', file=sys.stderr)
            return result.returncode if result.returncode > 0 else 128 - result.returncode
        if len(paths) != 1:
            raise ValueError('downloader did not report exactly one completed file')
        artifact = Path(paths[0]).resolve()
        if artifact.parent != output or not artifact.is_file() or artifact.stat().st_size == 0:
            raise ValueError('downloader reported a missing, empty, or unexpected output file')
        print('yt-dl: Checking downloaded quality...', file=sys.stderr, flush=True)
        verify_quality(artifact, args.url, runtime)
        print(artifact)
        return 0
    except (OSError, ValueError, KeyError, TypeError, ZeroDivisionError,
            subprocess.TimeoutExpired) as error:
        print(f'yt-dl: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
