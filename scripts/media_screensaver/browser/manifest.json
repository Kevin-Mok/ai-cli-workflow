{
  "manifest_version": 3,
  "name": "Media Screensaver Video Gate",
  "description": "Reports only playing-video geometry to the local screensaver.",
  "version": "1.0.0",
  "minimum_chrome_version": "119",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true
  }]
}
