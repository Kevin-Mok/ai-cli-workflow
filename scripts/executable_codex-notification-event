#!/usr/bin/env python3
"""Resolve Codex identity and detach completion-title or queued-question audio."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from uuid import UUID
from typing import cast

try:
    from codex_notification_source import capture_source  # pyright: ignore[reportImplicitRelativeImport]
except ImportError:
    def capture_source() -> dict[str, object] | None:
        return None


def codex_home() -> Path:
    return Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex').resolve()


def speech_enabled() -> bool:
    path = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'codex-notification-sound/speech.json'
    try:
        data = json.loads(path.read_text(encoding='utf-8'))
        return isinstance(data, dict) and data.get('enabled') is True
    except (OSError, ValueError, UnicodeError):
        return False


def valid_id(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    try:
        return str(UUID(value)) if str(UUID(value)) == value.lower() else None
    except ValueError:
        return None


def metadata(path: Path) -> dict[str, object] | None:
    try:
        resolved = path.resolve(strict=True)
        if not resolved.is_relative_to(codex_home()) or not resolved.is_file():
            return None
        with resolved.open(encoding='utf-8') as transcript:
            # First session_meta is authoritative; later copied records never override it.
            for _ in range(32):
                line = transcript.readline(1024 * 1024)
                if not line:
                    break
                record = json.loads(line)
                if isinstance(record, dict) and record.get('type') == 'session_meta':
                    payload = record.get('payload')
                    return cast(dict[str, object], payload) if isinstance(payload, dict) else None
    except (OSError, ValueError, UnicodeError, RuntimeError):
        pass
    return None


def internal(meta: dict[str, object]) -> bool:
    # Classify provenance discriminants/roles, never nicknames or parent IDs.
    def reserved(value: object) -> bool:
        return isinstance(value, str) and bool(re.search(
            r'(^|[^a-z])(system|review|reviewer|guardian|session_review)([^a-z]|$)', value.lower()))

    def source_reserved(value: object) -> bool:
        if isinstance(value, str):
            return reserved(value)
        if isinstance(value, dict):
            source = cast(dict[str, object], value)
            for key, child in source.items():
                if reserved(key):
                    return True
                if key in ('subagent', 'thread_spawn') and source_reserved(child):
                    return True
                if key in ('other', 'agent_role', 'agent_type') and reserved(child):
                    return True
        return False

    return source_reserved(meta.get('source')) or any(
        reserved(meta.get(key)) for key in ('agent_role', 'agent_type'))


def user_facing(meta: dict[str, object]) -> bool:
    # Worker results are collected by their parent, including copied finals on
    # spawn. Unknown source formats cannot establish a user-facing answer.
    return (meta.get('source') in ('cli', 'vscode') and not internal(meta)
            and not any(meta.get(key) for key in ('parent_thread_id', 'parent_session_id')))


def latest_title(identity: str) -> str | None:
    title = None
    try:
        with (codex_home() / 'session_index.jsonl').open(encoding='utf-8') as index:
            for line in index:
                try:
                    record = json.loads(line)
                except ValueError:
                    continue  # Concurrent append may leave a partial last record.
                if isinstance(record, dict) and record.get('id') == identity:
                    value = record.get('thread_name')
                    title = value if isinstance(value, str) and value.strip() and not any(ord(c) < 32 for c in value) else None
    except (OSError, UnicodeError):
        return None
    return title


def resolve_event(event: object) -> tuple[bool, str | None]:
    if not isinstance(event, dict):
        return False, None
    meta = None
    if event.get('hook_event_name') == 'PermissionRequest':
        path = event.get('transcript_path')
        meta = metadata(Path(path)) if isinstance(path, str) and Path(path).is_absolute() else None
        identity = valid_id(meta.get('id')) if meta else None
        if meta and internal(meta):
            return False, None
        if 'agent_id' in event and valid_id(event['agent_id']) != identity:
            return True, None
    elif event.get('type') == 'agent-turn-complete':
        identity = valid_id(event.get('thread-id'))
        if identity:
            ambiguous = False
            excluded = False
            # Filenames may hold a rollout UUID distinct from the conversation UUID.
            for folder in ('sessions', 'archived_sessions'):
                for path in (codex_home() / folder).rglob('*.jsonl'):
                    candidate = metadata(path)
                    if candidate and valid_id(candidate.get('id')) == identity:
                        excluded = excluded or not user_facing(candidate)
                        ambiguous = ambiguous or (meta is not None and candidate != meta)
                        meta = candidate
            if excluded:
                return False, None
            if ambiguous:
                return False, None
        if meta is None:
            return False, None
    else:
        return False, None
    return True, latest_title(identity) if identity and meta else None


def question_summary(tool_name: object, tool_input: object) -> str | None:
    """Extract one bounded sentence from question prompts; never read choices."""
    if tool_name not in ('request_user_input', 'request_user_input_async'):
        return None
    if isinstance(tool_input, str):
        try:
            tool_input = json.loads(tool_input)
        except ValueError:
            return None
    if not isinstance(tool_input, dict):
        return None
    questions = tool_input.get('questions')
    if not isinstance(questions, list) or not questions:
        return None
    if tool_name == 'request_user_input':
        # The blocking hook precedes native validation. Reject the whole call
        # if any required question/option field cannot form a valid request.
        for question in questions:
            if not isinstance(question, dict) or any(
                    not isinstance(question.get(key), str) or not question[key].strip()
                    for key in ('id', 'header', 'question')):
                return None
            options = question.get('options')
            if options is not None and (not isinstance(options, list) or any(
                    not isinstance(option, dict) or any(not isinstance(option.get(key), str)
                    for key in ('label', 'description')) for option in options)):
                return None
    prompts: list[str] = []
    field = 'title' if tool_name == 'request_user_input_async' else 'question'
    for question in questions:
        if not isinstance(question, dict) or question.get('isSecret') is True:
            continue
        text = question.get(field)
        if not isinstance(text, str):
            continue
        text = ' '.join(re.sub(r'[\x00-\x1f\x7f-\x9f]', ' ', text).split())
        if not text:
            continue
        sentences = re.split(r'(?<=[.!?])\s+', text)
        # Context often precedes the actual ask. Prefer its last question.
        ask = next((part for part in reversed(sentences) if part.endswith('?')), text)
        ask = re.sub(r'[.!?](?=\s|$)', ';', ask).strip(' .!?;')
        if ask:
            prompts.append(ask)
    if not prompts:
        return None
    remaining = max(0, len(prompts) - 3)
    tail = f'; and {remaining} more question' + ('s' if remaining != 1 else '') if remaining else ''
    prompts = prompts[:3]
    budget = (280 - len('Codex asks: ') - len(tail) - 1 - 2 * (len(prompts) - 1)) // len(prompts)
    shortened = [prompt if len(prompt) <= budget else prompt[:budget - 1].rsplit(' ', 1)[0] + '…' for prompt in prompts]
    return 'Codex asks: ' + '; '.join(shortened) + tail + '?'


def resolve_question(event: dict[str, object]) -> tuple[bool, str | None]:
    summary = question_summary(event.get('tool_name'), event.get('tool_input'))
    path = event.get('transcript_path')
    meta = metadata(Path(path)) if isinstance(path, str) and Path(path).is_absolute() else None
    identity = valid_id(meta.get('id')) if meta else None
    if (summary is None or meta is None or meta.get('source') not in ('cli', 'vscode')
            or internal(meta) or any(meta.get(key) for key in ('parent_thread_id', 'parent_session_id'))
            or identity is None
            or valid_id(event.get('session_id')) != identity
            or ('agent_id' in event and valid_id(event['agent_id']) != identity)):
        return False, None
    return True, summary


def main(argv: list[str] | None = None) -> int:
    try:
        if not speech_enabled():
            return 0
        args = sys.argv[1:] if argv is None else argv
        event = json.loads(args[0]) if args else json.load(sys.stdin)
        # Loaded PermissionRequest hooks may survive config changes in active
        # sessions. Keep these calls silent even after the hook is removed.
        if not isinstance(event, dict):
            return 0
        hook = event.get('hook_event_name')
        tool_name = event.get('tool_name')
        if hook == 'PreToolUse' and tool_name == 'request_user_input':
            eligible, title = resolve_question(event)
        elif hook == 'PostToolUse' and tool_name == 'request_user_input_async':
            response = event.get('tool_response')
            if isinstance(response, str):
                response = json.loads(response)
            if not isinstance(response, dict) or response.get('accepted') is not True:
                return 0
            eligible, title = resolve_question(event)
        elif event.get('type') == 'agent-turn-complete':
            answer = event.get('last-assistant-message')
            if not isinstance(answer, str) or not answer.strip():
                return 0
            eligible, title = resolve_event(event)
        else:
            return 0
        if eligible:
            helper = Path(__file__).with_name('codex-notification-sound')
            if not helper.exists():
                helper = helper.with_name('executable_codex-notification-sound')
            source = capture_source()
            command = [sys.executable, str(helper), 'event-play']
            if source is not None:
                command.extend(['--source', json.dumps(source)])
            child = subprocess.Popen(command,
                                     stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True, text=True)
            if child.stdin is not None:
                child.stdin.write(json.dumps(title))
                child.stdin.close()
        return 0
    except (OSError, ValueError, UnicodeError, RuntimeError, subprocess.SubprocessError):
        return 0  # No stdout, approval decision, or failure propagated into Codex.


if __name__ == '__main__':
    raise SystemExit(main())
