#!/usr/bin/env python3
"""Scale Kitty OS windows by i3 output, keeping baselines inside each Kitty."""
import argparse
import glob
import json
import os
from pathlib import Path
import select
import socket
import stat
import struct
import subprocess
import sys
import time


def run(command):
    return subprocess.run(command, check=True, capture_output=True, text=True, timeout=4).stdout


def placements(node, output=None):
    if node.get("type") == "output":
        output = node["name"]
    result = {}
    if node.get("window") and output and output != "__i3":
        result[str(node["window"])] = output
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        result.update(placements(child, output))
    return result


def reconcile(mode, kitty, adapter):
    outputs = {} if mode == "restore" else placements(json.loads(run(["i3-msg", "-t", "get_tree"])))
    rows, unavailable = [], 0
    for name in sorted(glob.glob("/tmp/kitty-*") + glob.glob("/tmp/kitty")):
        try:
            metadata = os.lstat(name)
            if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != os.getuid():
                continue
            response = run([kitty, "@", "--to", "unix:" + name, "kitten", "--match", "all",
                            str(adapter), mode, json.dumps(outputs)])
            rows.extend(json.loads(response))
        except (OSError, subprocess.SubprocessError, ValueError, TypeError):
            unavailable += 1
    return {"windows": rows, "unavailable_sockets": unavailable}


def receive(sock):
    def read(count):
        data = b""
        while len(data) < count:
            block = sock.recv(count - len(data))
            if not block:
                raise ConnectionError("i3 disconnected")
            data += block
        return data
    magic, size, kind = struct.unpack("=6sII", read(14))
    if magic != b"i3-ipc" or size > 16 * 1024 * 1024:
        raise ValueError("Invalid i3 IPC response")
    return kind, json.loads(read(size))


def watch(kitty, adapter, message):
    started, heartbeat = time.monotonic(), 0.
    while True:
        try:
            with socket.socket(socket.AF_UNIX) as events:
                events.settimeout(4)
                events.connect(run(["i3", "--get-socketpath"]).strip())
                payload = b'["workspace","window","output","shutdown"]'
                events.sendall(struct.pack("=6sII", b"i3-ipc", len(payload), 2) + payload)
                _, ack = receive(events)
                if not ack.get("success"):
                    raise ValueError("i3 subscription refused")
                while True:
                    report = reconcile("apply", kitty, adapter)
                    now = time.monotonic()
                    if now - heartbeat >= 60:
                        message(f"Watching {len(report['windows'])} Kitty windows; "
                                f"{report['unavailable_sockets']} unavailable sockets; "
                                f"elapsed {int(now - started)}s")
                        heartbeat = now
                    if select.select([events], [], [], 2)[0]:
                        receive(events)
                        # Coalesce geometry events generated by changing font metrics.
                        time.sleep(0.2)
                        while select.select([events], [], [], 0)[0]:
                            receive(events)
        except (OSError, subprocess.SubprocessError, ValueError) as error:
            message(f"Desktop unavailable; retrying in 2s ({type(error).__name__})")
            time.sleep(2)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=["watch", "status", "once", "restore"])
    parser.add_argument("--plain", action="store_true", help="ASCII messages")
    parser.add_argument("--json", action="store_true", help="machine-readable status/results")
    args = parser.parse_args()
    kitty = str(Path.home() / ".local/bin/kitty")
    source = Path(__file__).resolve().parents[1] / "dot_config/kitty/monitor_font.py"
    adapter = source if source.is_file() else Path.home() / ".config/kitty/monitor_font.py"

    def message(text):
        print(("" if args.plain else "🖥️  ") + text, file=sys.stderr, flush=True)

    try:
        if args.mode == "watch":
            watch(kitty, adapter, message)
        else:
            if args.mode == "restore":
                run(["systemctl", "--user", "stop", "kitty-monitor-font.service"])
            report = reconcile("apply" if args.mode == "once" else args.mode, kitty, adapter)
            if args.json:
                print(json.dumps(report, indent=2))
            else:
                message(f"Kitty font {args.mode}: {len(report['windows'])} windows; "
                        f"{report['unavailable_sockets']} unavailable sockets")
                for row in report["windows"]:
                    print(f"X11 {row['platform_window_id']}: {row['output'] or 'unknown'}  "
                          f"current {row['current']:.3f}pt  baseline {row['baseline']:.3f}pt  "
                          f"target {row['target']:.3f}pt")
            return 1 if report["unavailable_sockets"] else 0
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        message(f"Cannot query desktop ({type(error).__name__}); check i3 and Kitty socket access")
        return 1
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
