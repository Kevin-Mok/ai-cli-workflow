#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: rsync-media-date YYYY-MM-DD SOURCE DESTINATION\n' >&2
}

fail() {
  printf 'rsync-media-date: %s\n' "$1" >&2
  exit 1
}

if [ "$#" -ne 3 ]; then
  usage
  exit 1
fi

requested_date="$1"
source_root="${2%/}"
destination="${3%/}"

if ! [[ "$requested_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || \
  [ "$(date -d "$requested_date" +%F 2>/dev/null || true)" != "$requested_date" ]; then
  fail 'date must use YYYY-MM-DD format'
fi

command -v rsync >/dev/null 2>&1 || fail 'rsync is required but unavailable'

media_root="${source_root}/DCIM"
[ -d "$media_root" ] && [ -r "$media_root" ] || fail "source media directory is unavailable: $media_root"

start_boundary="$(date -d "$requested_date - 1 second" '+%F %T')"
end_boundary="$(date -d "$requested_date + 1 day - 1 second" '+%F %T')"
file_list="$(mktemp)"
trap 'rm -f "$file_list"' EXIT

find "$media_root" -type f \
  \( -iname '*.mov' -o -iname '*.mp4' -o -iname '*.m4v' \) \
  -newermt "$start_boundary" ! -newermt "$end_boundary" \
  -print0 > "$file_list"

if [ ! -s "$file_list" ]; then
  fail "no media found in $media_root for $requested_date"
fi

mkdir -p -- "$destination"

mapfile -d '' -t media_files < "$file_list"
printf 'Copying %d media file(s) from %s to %s\n' "${#media_files[@]}" "$requested_date" "$destination"
exec rsync --archive --info=progress2 --human-readable --no-relative -- "${media_files[@]}" "${destination}/"
