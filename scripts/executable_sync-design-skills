#!/usr/bin/env bash

# Human-facing decoration; keep protocol/data output unchanged.
cli_emoji() {
  [ "${CLI_PLAIN:-0}" = 1 ] || printf '%s ' "$1"
}
set -euo pipefail

usage() {
  printf '%s' "$(cli_emoji '📖')"
  cat <<'USAGE'
Usage: sync-design-skills [--dry-run|--bootstrap]

Refresh the retained Impeccable source and Higgsfield plugin.
--dry-run previews external refreshes without modifying skill files.
--bootstrap is a compatibility no-op; no separate bootstrap is needed.
USAGE
}

mode=refresh
case "${1:-}" in
  --dry-run|-n) mode=dry-run ;;
  --bootstrap) mode=bootstrap ;;
  --help|-h) usage; exit 0 ;;
  "") ;;
  *) echo "$(cli_emoji '❌')sync-design-skills: unknown option: $1" >&2; usage >&2; exit 2 ;;
esac

source_dir="${LINUX_CONFIG_SOURCE:-$HOME/linux-config}"
if [[ ! -d "$source_dir" ]]; then
  echo "$(cli_emoji '❌')sync-design-skills: source directory not found: $source_dir" >&2
  exit 1
fi

if [[ "$mode" == bootstrap ]]; then
  echo "$(cli_emoji '✅')Design sources use chezmoi; no separate bootstrap is needed."
  exit 0
fi

targets=(
  "$HOME/.codex/skills/upstreams/impeccable"
  "$HOME/.codex/plugins/higgsfield"
)
apply_args=(-S "$source_dir" apply --refresh-externals -v)
if [[ "$mode" == dry-run ]]; then
  apply_args+=(-n)
fi
echo "$(cli_emoji '🔄')Refreshing managed design sources; chezmoi will report each operation."
chezmoi "${apply_args[@]}" "${targets[@]}"

if [[ "$mode" == dry-run ]]; then
  echo "$(cli_emoji '✅')Design skill refresh preview complete."
  exit 0
fi

echo "$(cli_emoji 'ℹ️')Design skills refreshed. Restart agent sessions to load updates."
