#!/usr/bin/env python3
"""Preview or relocate four cold home folders to the USB mount, then clean caches."""
import argparse
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

FOLDERS = ('Videos', 'Downloads', 'root-backup', 'Android')
CLEANERS = (('npm', 'cache', 'clean', '--force'), ('pip', 'cache', 'purge'),
            ('uv', 'cache', 'clean'), ('go', 'clean', '-cache'))
PLAIN = False
DETAILS = False


def say(message, icon='📦'):
    print(f'{icon} {message}' if not PLAIN else message, flush=True)


def run(args, label):
    """Use a file, not pipes, so verbose tools cannot deadlock during heartbeat waits."""
    say(label)
    started = time.monotonic()
    with tempfile.TemporaryFile(mode='w+t') as log:
        with subprocess.Popen(args, stdout=log, stderr=log) as proc:
            try:
                while True:
                    try:
                        code = proc.wait(timeout=5)
                        break
                    except subprocess.TimeoutExpired:
                        say(f'{label}: active for {int(time.monotonic() - started)}s', '⏳')
            except BaseException:
                proc.terminate()
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                raise
        log.seek(0)
        output = log.read()
    if DETAILS and output:
        print(output, end='')
    if code:
        raise RuntimeError(f'{label} failed (exit {code}). '
                           'Use --details for diagnostics; inspect partial destinations before retrying.')
    return output


def inspect_source(src, usb):
    dst = usb / src.name
    retained = src.with_name(src.name + '.offload-original')
    if os.path.lexists(retained):
        raise RuntimeError(f'Inspect retained original before retrying: {retained}')
    if src.is_symlink():
        if src.readlink() == dst and dst.is_dir():
            return False
        raise RuntimeError(f'Refusing unexpected or broken symlink: {src}')
    if not src.exists():
        if os.path.lexists(dst):
            raise RuntimeError(f'Source missing but destination exists; inspect: {dst}')
        return False
    if not src.is_dir() or src.is_mount():
        raise RuntimeError(f'Refusing non-directory or mounted source: {src}')
    if os.path.lexists(dst):
        raise RuntimeError(f'Destination already exists; inspect before retrying: {dst}')
    return True


def identity(path):
    stat = path.stat()
    return stat.st_dev, stat.st_ino


def relocate(src, usb, apply):
    if not inspect_source(src, usb):
        say(f'Skip {src}: missing or already linked')
        return
    dst = usb / src.name
    say(f'{src} -> {dst}')
    if not apply:
        return
    mount_identity = identity(usb)
    run(['rsync', '-aHAX', '--', str(src) + '/', str(dst) + '/'], f'Copy {src.name}')
    difference = run(['rsync', '-aHAXnci', '--delete', '--', str(src) + '/', str(dst) + '/'],
                     f'Verify {src.name} checksums')
    if difference.strip():
        raise RuntimeError(f'Verification differs for {src}; original retained. Close writers and inspect {dst}.')
    run(['sync', '-f', str(dst)], f'Flush verified copy {src.name}')
    if identity(usb) != mount_identity:
        raise RuntimeError('USB identity changed; original retained.')
    retained = src.with_name(src.name + '.offload-original')
    src.rename(retained)
    try:
        src.symlink_to(dst, target_is_directory=True)
    except BaseException:
        retained.rename(src)
        raise
    if identity(usb) != mount_identity or not dst.is_dir():
        raise RuntimeError(f'USB changed; keep retained original at {retained}.')
    # Keep the retained original on interruption; never remove through the new link.
    run(['rm', '-rf', '--one-file-system', '--', str(retained)], f'Remove verified original {src.name}')
    say(f'Moved and linked {src.name}', '✅')


def preflight(home, usb):
    if not usb.is_mount():
        raise RuntimeError(f'USB must be mounted at {usb}; refusing a plain directory.')
    if usb.stat().st_dev == home.stat().st_dev:
        raise RuntimeError('USB and home are on the same filesystem; no home space would be freed.')
    if not os.access(usb, os.W_OK):
        raise RuntimeError(f'USB is not writable: {usb}; run as its owning user, without sudo.')
    for tool in ('rsync', 'du', 'rm', 'sync'):
        if not shutil.which(tool):
            raise RuntimeError(f'Required command missing: {tool}')
    needed = 0
    for name in FOLDERS:
        src = home / name
        if inspect_source(src, usb):
            output = run(['du', '-s', '--block-size=1', '--apparent-size', '--', str(src)],
                         f'Measure {name}')
            needed += int(output.split()[0])
    free = shutil.disk_usage(usb).free
    say(f'Copy estimate: {needed / 1024**3:.1f} GiB; USB free: {free / 1024**3:.1f} GiB')
    if free < needed + 1024**3:
        raise RuntimeError('USB needs the copy estimate plus 1 GiB of spare space.')


def main():
    global PLAIN, DETAILS
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--destination', required=True, type=Path, help='mounted writable destination on a different filesystem')
    parser.add_argument('--apply', action='store_true', help='perform moves and cache cleanup (default: preview)')
    parser.add_argument('--plain', action='store_true', help='ASCII output without decorative emojis')
    parser.add_argument('--details', action='store_true', help='show underlying command diagnostics')
    args = parser.parse_args()
    PLAIN, DETAILS = args.plain, args.details
    home, usb = Path.home(), args.destination.expanduser().absolute()
    say('Home storage offload: ' + ('APPLY' if args.apply else 'PREVIEW'), '🧭')
    say('Close all apps using these folders, including Android tools.', '⚠️')
    if args.apply and os.geteuid() == 0:
        raise RuntimeError('Run as your normal account, without sudo.')
    # Lock the script inode: prevent overlapping runs without creating home files.
    with open(__file__) as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Another home storage offload is running.') from None
        preflight(home, usb)
        mount_identity = identity(usb)
        for name in FOLDERS:
            if not usb.is_mount() or identity(usb) != mount_identity:
                raise RuntimeError('USB mount changed; stopping before the next folder.')
            relocate(home / name, usb, args.apply)
        failed = []
        for command in CLEANERS:
            if not shutil.which(command[0]):
                say(f'Skip unavailable cleaner: {command[0]}', '⚠️')
            elif args.apply:
                try:
                    run(list(command), 'Clean cache: ' + ' '.join(command))
                except RuntimeError as exc:
                    say(str(exc), '⚠️')
                    failed.append(command[0])
            else:
                say('Would run: ' + ' '.join(command), '🧹')
        if failed:
            raise RuntimeError('Cache cleaners failed: ' + ', '.join(failed))
        say('Finished' if args.apply else 'Preview only. Run with --apply to execute.', '✅')
        usage = shutil.disk_usage(home)
        say(f'Home filesystem free now: {usage.free / 1024**3:.1f} GiB')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError) as exc:
        say(str(exc), '❌')
        sys.exit(1)
    except KeyboardInterrupt:
        say('Interrupted. Inspect partial destinations or retained originals before retrying.', '⚠️')
        sys.exit(130)
