#!/usr/bin/env python3
"""Validate the live Codex config without copying private settings into source."""

from __future__ import annotations

import argparse
import sys
from typing import Sequence

from second_brain.config_snapshot import ConfigSnapshotError, snapshot_codex_config


def _cli_message(text, icon):
    """Decorate human output; CLI_PLAIN=1 keeps legacy scripts undecorated."""
    import os
    import sys
    plain = os.environ.get('CLI_PLAIN') == '1' or '--plain' in sys.argv
    return ('' if plain else icon + ' ') + text


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="snapshot-codex-config",
        description=_cli_message("Validate the live Codex config; keep live settings private.", '🧰'),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate source and target without changing the target.",
    )
    args = parser.parse_args(argv)
    try:
        result = snapshot_codex_config(dry_run=args.dry_run)
    except (ConfigSnapshotError, OSError, UnicodeError):
        print(
            _cli_message("snapshot-codex-config: snapshot validation failed", '❌'),
            file=sys.stderr,
        )
        return 2

    print(_cli_message("Codex config validated; live settings remain private.", '✅'))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
