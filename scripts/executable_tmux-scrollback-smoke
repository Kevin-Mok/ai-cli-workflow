#!/usr/bin/env python3
"""Open a disposable tmux session in Kitty to inspect pane history gestures."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import termios
import tty


def main():
    plain = "--plain" in sys.argv or os.environ.get("CLI_PLAIN") == "1"
    parser = argparse.ArgumentParser(description=("" if plain else "🧪 ") + "Inspect tmux history in a separate Kitty window; no sudo needed.")
    parser.add_argument("--lines", type=int, default=3000, help="numbered history records (default: 3000)")
    parser.add_argument("--app-mouse", action="store_true", help="simulate an application that handles mouse events")
    parser.add_argument("--scrollbar", action="store_true", help="preview prepared tmux 3.8 with a draggable pane scrollbar")
    parser.add_argument("--plain", action="store_true", help="ASCII output")
    parser.add_argument("--emit", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    plain = args.plain or os.environ.get("CLI_PLAIN") == "1"
    def message(icon, text):
        print(("" if plain else icon + " ") + text, flush=True)
    if args.lines < 1:
        parser.error("--lines must be positive")
    if args.emit:
        for n in range(1, args.lines + 1):
            suffix = " WRAPPED logical line: " + "word " * 35 + "END" if n % 10 == 0 else ""
            print(f"HISTORY {n:06d} | tmux-owned output: drag selects text.{suffix}")
        message("🖱", "Stay inside the pane, below the titlebar; do not hold Shift while dragging. Shift+wheel also browses history.")
        if args.scrollbar:
            message("🖱", "Drag the right-edge scrollbar to browse tmux history; Escape returns to live input.")
            message("⚠️", "Legacy held-edge text selection differs in this preview; keep existing work on tmux 3.4.")
        else:
            message("🧪", "Drag text to the first text row; keep holding there to select older screens. Release, then Ctrl+Shift+C.")
            message("ℹ️", "tmux 3.4 has no draggable pane scrollbar. Kitty's thumb cannot browse this history.")
        message("⌨️", "Escape returns to live input. Type hello and Enter; Ctrl+D at empty input closes this fixture.")
        if not args.app_mouse:
            try:
                while True:
                    line = input("INPUT> ")
                    message("✅", f"INPUT {line}")
            except EOFError:
                return 0
        saved = termios.tcgetattr(0)
        try:
            tty.setraw(0)
            os.write(1, b"\x1b[?1000h\x1b[?1006h")
            line = b""
            while True:
                char = os.read(0, 1)
                if not char or char == b"\x04":
                    break
                if char == b"\x1b":
                    event = char
                    while not event.endswith((b"M", b"m")) and len(event) < 64:
                        event += os.read(0, 1)
                    os.write(1, b"\r\nAPP_MOUSE " + event.replace(b"\x1b", b"ESC") + b"\r\n")
                elif char in (b"\r", b"\n"):
                    os.write(1, b"\r\nINPUT " + line + b"\r\n")
                    line = b""
                else:
                    line += char
                    os.write(1, char)
        finally:
            os.write(1, b"\x1b[?1000l\x1b[?1006l")
            termios.tcsetattr(0, termios.TCSADRAIN, saved)
        return 0
    tmux_binary = str(Path.home() / ".local/opt/tmux-3.8/bin/tmux") if args.scrollbar else "tmux"
    kitty_binary = Path.home() / ".local/bin/kitty"
    kitty_binary = str(kitty_binary) if kitty_binary.is_file() else "kitty"
    for binary in (kitty_binary, tmux_binary):
        if not shutil.which(binary):
            parser.error(f"{binary} must be installed")
    config = Path.home() / ".tmux.conf"
    if not config.is_file():
        parser.error(f"missing config: {config}; run refresh-config first")
    import shlex
    with tempfile.TemporaryDirectory(prefix="tmux-scrollback-") as directory:
        socket = str(Path(directory) / "socket")
        env = dict(os.environ)
        env.pop("TMUX", None)
        if args.scrollbar:
            env["PATH"] = str(Path(tmux_binary).parent) + os.pathsep + env.get("PATH", os.defpath)
        def tmux(*words):
            subprocess.run([tmux_binary, "-S", socket, *words], env=env, check=True)
        message("🧪", "Opening an isolated tmux history fixture; existing sessions stay running.")
        try:
            tmux("-f", "/dev/null", "new-session", "-d", "-s", "scrolling", "sleep 86400")
            tmux("source-file", str(config))
            if args.scrollbar:
                tmux("set-option", "-gw", "pane-scrollbars", "on")
            command = [sys.executable, str(Path(__file__).resolve()), "--emit", "--lines", str(args.lines)]
            if args.scrollbar:
                command.append("--scrollbar")
            if args.app_mouse:
                command.append("--app-mouse")
            if plain:
                command.append("--plain")
            tmux("new-window", "-n", "history", shlex.join(command))
            tmux("kill-window", "-t", "scrolling:0")
            return subprocess.call([kitty_binary, "--title", "tmux scrollback smoke test", tmux_binary, "-S", socket, "attach", "-t", "scrolling"], env=env)
        finally:
            subprocess.run([tmux_binary, "-S", socket, "kill-server"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
