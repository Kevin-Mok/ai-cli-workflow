#!/usr/bin/env python3
"""Exercise real Context Mode MCP retrieval using disposable data and state."""
import argparse
import json
import os
from pathlib import Path
import selectors
import subprocess
import sys
import tempfile
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--case", choices=("index", "search", "empty"), default="search")
    parser.add_argument("--package", type=Path, default=Path.home() / ".local/share/context-mode/1.0.169/node_modules/context-mode")
    parser.add_argument("--plain", action="store_true", help="ASCII output")
    args = parser.parse_args()
    package = args.package.resolve()
    if not (package / "cli.bundle.mjs").is_file():
        parser.error("Pinned package missing; install first or pass --package PATH")
    glyph = "" if args.plain else "🔎 "
    print(f"{glyph}Context Mode {args.case} demo - disposable state", flush=True)
    with tempfile.TemporaryDirectory(prefix="context-mode-demo-") as directory:
        root = Path(directory)
        env = {"PATH": os.environ["PATH"], "HOME": str(root),
               "CONTEXT_MODE_DIR": str(root / "state"), "CONTEXT_MODE_PLATFORM": "codex",
               "CONTEXT_MODE_PROJECT_DIR": str(root)}
        with (root / "stderr.log").open("w+") as diagnostics:
            process = subprocess.Popen(["node", str(package / "cli.bundle.mjs")],
                                       cwd=root, env=env, stdin=subprocess.PIPE,
                                       stdout=subprocess.PIPE, stderr=diagnostics)
            selector = selectors.DefaultSelector()
            selector.register(process.stdout, selectors.EVENT_READ)
            request_id = 0

            def request(method, params):
                nonlocal request_id
                request_id += 1
                process.stdin.write((json.dumps({"jsonrpc": "2.0", "id": request_id,
                                                "method": method, "params": params}) + "\n").encode())
                process.stdin.flush()
                deadline = time.monotonic() + 30
                while time.monotonic() < deadline:
                    if not selector.select(timeout=1):
                        print(f"{glyph}Waiting for {method}...", file=sys.stderr, flush=True)
                        continue
                    line = process.stdout.readline()
                    if not line:
                        raise RuntimeError("MCP server exited before replying")
                    response = json.loads(line)
                    if response.get("id") != request_id:
                        continue
                    if "error" in response:
                        raise RuntimeError(str(response["error"]))
                    result = response["result"]
                    if result.get("isError"):
                        raise RuntimeError(str(result))
                    return result
                raise RuntimeError(f"Timed out waiting for {method}")

            def call(name, arguments):
                result = request("tools/call", {"name": name, "arguments": arguments})
                return "\n".join(block.get("text", "") for block in result.get("content", []))

            try:
                request("initialize", {"protocolVersion": "2024-11-05", "capabilities": {},
                                       "clientInfo": {"name": "context-mode-dotfiles-demo", "version": "1"}})
                process.stdin.write(b'{"jsonrpc":"2.0","method":"notifications/initialized"}\n')
                process.stdin.flush()
                indexed = call("ctx_index", {"content": "# Release procedure\n\nThe release marker is ORCHID742. Deploy after review.\n", "source": "dotfiles-demo"})
                if args.case == "index":
                    print(indexed)
                    print(call("ctx_stats", {}))
                else:
                    query = "ORCHID742" if args.case == "search" else "absentmarker917"
                    result = call("ctx_search", {"queries": [query], "source": "dotfiles-demo", "limit": 1})
                    print(result)
                    if args.case == "search" and "ORCHID742" not in result:
                        raise RuntimeError("Search did not retrieve the indexed marker")
                    if args.case == "empty" and "No results found." not in result:
                        raise RuntimeError("Absent marker did not produce a no-result response")
                print(f"{'✅ ' if not args.plain else ''}Demo complete; live client configuration unchanged.")
            except (RuntimeError, ValueError) as error:
                print(f"{'❌ ' if not args.plain else ''}{error}", file=sys.stderr)
                return 1
            finally:
                selector.close()
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
