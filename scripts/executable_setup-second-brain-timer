#!/usr/bin/env python3
"""Validate, enable, or disable the Second Brain user timer."""

from __future__ import annotations

import argparse
import fcntl
import os
import stat
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path
from typing import Iterator, Sequence

from second_brain.paths import ensure_private_directory, state_root
from second_brain.safe_contract import PathError
from second_brain.safe_files import ensure_owned_directories, regular_file_bytes


LAUNCHER_NAME = "second-brain"
PACKAGE_NAME = "second_brain"
SERVICE_NAME = "second-brain-checkpoint.service"
TIMER_NAME = "second-brain-checkpoint.timer"
DEFERRED_SERVICE_NAME = "second-brain-deferred.service"
DEFERRED_TIMER_NAME = "second-brain-deferred.timer"
UNIT_NAMES = (
    SERVICE_NAME,
    TIMER_NAME,
    DEFERRED_SERVICE_NAME,
    DEFERRED_TIMER_NAME,
)
TIMER_NAMES = (TIMER_NAME, DEFERRED_TIMER_NAME)
RUNTIME_MODULE_NAMES = (
    "__init__.py",
    "checkpoint.py",
    "checkpoint_contract.py",
    "checkpoint_git.py",
    "checkpoint_scan.py",
    "cli.py",
    "config_snapshot.py",
    "content_security.py",
    "deferred.py",
    "doctor.py",
    "doctor_contract.py",
    "doctor_lfs.py",
    "migration.py",
    "migration_apply.py",
    "migration_common.py",
    "migration_inventory.py",
    "migration_verify.py",
    "paths.py",
    "safe_contract.py",
    "safe_create.py",
    "safe_files.py",
    "schema.py",
    "state_private.py",
    "upgrade.py",
    "vault.py",
)
RUNTIME_SOURCE_DIRECTIVES = ("remove_state.py",)
LEGACY_RUNTIME_TARGET_NAMES = ("state.py",)


class TimerSetupError(RuntimeError):
    """Timer setup cannot proceed safely."""


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="setup-second-brain-timer",
        description="Manage the Second Brain systemd user timer.",
    )
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true", help="Validate the units.")
    action.add_argument("--enable", action="store_true", help="Install and enable.")
    action.add_argument("--disable", action="store_true", help="Disable the timer.")
    return parser


def _run(arguments: Sequence[str], failure: str) -> str:
    try:
        completed = subprocess.run(
            list(arguments),
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as error:
        raise TimerSetupError(failure) from error
    if completed.returncode != 0:
        raise TimerSetupError(failure)
    return completed.stdout.strip()


def _private_lock_path(*, require_repository: bool) -> Path:
    try:
        lock_dir = state_root(require_repository=require_repository) / "locks"
        ensure_private_directory(
            lock_dir,
            require_repository=require_repository,
        )
    except PathError as error:
        raise TimerSetupError("timer setup state path is unsafe") from error
    return lock_dir / "timer-setup.lock"


@contextmanager
def _setup_lock(*, require_repository: bool = True) -> Iterator[None]:
    lock_path = _private_lock_path(require_repository=require_repository)
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except OSError as error:
        raise TimerSetupError("timer setup lock could not be opened") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != os.geteuid()
        ):
            raise TimerSetupError("timer setup lock is unsafe")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise TimerSetupError(
                "another timer setup operation is already running"
            ) from error
        try:
            yield
        finally:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
    finally:
        os.close(descriptor)


def _managed_targets() -> tuple[Path, ...]:
    launcher = Path.home() / "scripts" / LAUNCHER_NAME
    package = launcher.parent / PACKAGE_NAME
    target_dir = Path.home() / ".config" / "systemd" / "user"
    return (
        launcher,
        package,
        *(target_dir / unit_name for unit_name in UNIT_NAMES),
    )


def _source_for(target: Path) -> Path:
    value = _run(
        ("chezmoi", "source-path", str(target)),
        "chezmoi unit source resolution failed",
    )
    source = Path(value).expanduser()
    try:
        metadata = source.lstat()
    except OSError as error:
        raise TimerSetupError("chezmoi unit source is missing") from error
    expected_name = {target.name, f"executable_{target.name}"}
    is_package = target.name == PACKAGE_NAME
    safe_type = (
        stat.S_ISDIR(metadata.st_mode)
        if is_package
        else stat.S_ISREG(metadata.st_mode)
    )
    if (
        not source.is_absolute()
        or source.is_symlink()
        or not safe_type
        or source.name not in expected_name
        or metadata.st_uid != os.geteuid()
    ):
        raise TimerSetupError("chezmoi unit source is unsafe")
    if target.name == LAUNCHER_NAME and not metadata.st_mode & 0o111:
        raise TimerSetupError("chezmoi command source is not executable")
    return source


def _runtime_modules(
    target_dir: Path,
    source_dir: Path,
) -> tuple[tuple[Path, ...], tuple[Path, ...], tuple[Path, ...]]:
    sources_by_name: dict[str, Path] = {}
    try:
        entries = sorted(source_dir.iterdir(), key=lambda path: path.name)
    except OSError as error:
        raise TimerSetupError(
            "chezmoi runtime package source is unsafe"
        ) from error
    for source in entries:
        if source.suffix != ".py":
            continue
        try:
            metadata = source.lstat()
        except OSError as error:
            raise TimerSetupError(
                "chezmoi runtime package source is unsafe"
            ) from error
        if (
            source.is_symlink()
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != os.geteuid()
        ):
            raise TimerSetupError("chezmoi runtime package source is unsafe")
        sources_by_name[source.name] = source
    expected_source_names = set(RUNTIME_MODULE_NAMES) | set(
        RUNTIME_SOURCE_DIRECTIVES
    )
    if set(sources_by_name) != expected_source_names:
        raise TimerSetupError("chezmoi runtime package source is incomplete")
    targets = tuple(target_dir / name for name in RUNTIME_MODULE_NAMES)
    sources = tuple(sources_by_name[name] for name in RUNTIME_MODULE_NAMES)
    cleanup_targets = tuple(
        target_dir / name for name in LEGACY_RUNTIME_TARGET_NAMES
    )
    return targets, sources, cleanup_targets


def _validate_sources() -> tuple[
    tuple[Path, ...],
    tuple[Path, ...],
    tuple[Path, ...],
    tuple[Path, ...],
    tuple[Path, ...],
]:
    targets = _managed_targets()
    sources = tuple(_source_for(target) for target in targets)
    module_targets, module_sources, cleanup_targets = _runtime_modules(
        targets[1],
        sources[1],
    )
    _run(
        ("systemd-analyze", "--user", "verify", *(str(path) for path in sources[2:])),
        "systemd unit validation failed",
    )
    _run(
        ("systemctl", "--user", "show-environment"),
        "systemd user manager is unavailable",
    )
    return targets, sources, module_targets, module_sources, cleanup_targets


def _validate_installed_launcher(launcher: Path, source: Path) -> None:
    try:
        metadata = launcher.lstat()
        installed = regular_file_bytes(launcher.parent, launcher)
        expected = regular_file_bytes(source.parent, source)
    except (OSError, PathError) as error:
        raise TimerSetupError(
            "installed Second Brain command is missing or not executable"
        ) from error
    if (
        launcher.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or not metadata.st_mode & 0o111
        or not os.access(launcher, os.X_OK)
        or installed != expected
    ):
        raise TimerSetupError(
            "installed Second Brain command is missing or not executable"
        )


def _prepare_install_parents(
    targets: tuple[Path, ...],
) -> None:
    home = Path.home()
    try:
        ensure_owned_directories(
            home,
            (
                targets[0].parent,
                targets[1],
                targets[2].parent,
            ),
        )
    except PathError as error:
        raise TimerSetupError("timer install parent is unsafe") from error


def _validate_installed_package(
    target_dir: Path,
    targets: tuple[Path, ...],
    sources: tuple[Path, ...],
) -> None:
    try:
        package_metadata = target_dir.lstat()
        entries = tuple(target_dir.iterdir())
    except OSError as error:
        raise TimerSetupError(
            "installed Second Brain runtime package is missing or stale"
        ) from error
    if (
        target_dir.is_symlink()
        or not stat.S_ISDIR(package_metadata.st_mode)
        or package_metadata.st_uid != os.geteuid()
    ):
        raise TimerSetupError(
            "installed Second Brain runtime package is missing or stale"
        )
    expected_names = set(RUNTIME_MODULE_NAMES)
    installed_names: set[str] = set()
    for entry in entries:
        try:
            metadata = entry.lstat()
        except OSError as error:
            raise TimerSetupError(
                "installed Second Brain runtime package is missing or stale"
            ) from error
        if entry.name == "__pycache__":
            if (
                entry.is_symlink()
                or not stat.S_ISDIR(metadata.st_mode)
                or metadata.st_uid != os.geteuid()
            ):
                raise TimerSetupError(
                    "installed Second Brain runtime package is missing or stale"
                )
            continue
        if (
            entry.name not in expected_names
            or entry.is_symlink()
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != os.geteuid()
        ):
            raise TimerSetupError(
                "installed Second Brain runtime package is missing or stale"
            )
        installed_names.add(entry.name)
    if installed_names != expected_names:
        raise TimerSetupError(
            "installed Second Brain runtime package is missing or stale"
        )
    for target, source in zip(targets, sources, strict=True):
        try:
            installed = regular_file_bytes(target.parent, target)
            expected = regular_file_bytes(source.parent, source)
        except (OSError, PathError) as error:
            raise TimerSetupError(
                "installed Second Brain runtime package is missing or stale"
            ) from error
        if installed != expected:
            raise TimerSetupError(
                "installed Second Brain runtime package is missing or stale"
            )


def _validate_installed_units(
    targets: tuple[Path, ...],
    sources: tuple[Path, ...],
) -> None:
    for target, source in zip(targets, sources, strict=True):
        try:
            installed = regular_file_bytes(target.parent, target)
            expected = regular_file_bytes(source.parent, source)
        except (OSError, PathError) as error:
            raise TimerSetupError(
                "installed systemd units are missing or stale"
            ) from error
        if installed != expected:
            raise TimerSetupError("installed systemd units are missing or stale")
    _run(
        ("systemd-analyze", "--user", "verify", *(str(path) for path in targets)),
        "installed systemd unit validation failed",
    )


def _check() -> None:
    targets, sources, module_targets, module_sources, _cleanup = _validate_sources()
    _validate_installed_launcher(targets[0], sources[0])
    _validate_installed_package(targets[1], module_targets, module_sources)
    _validate_installed_units(targets[2:], sources[2:])
    print("Second Brain timer units are valid.")


def _enable() -> None:
    (
        targets,
        sources,
        module_targets,
        module_sources,
        cleanup_targets,
    ) = _validate_sources()
    _prepare_install_parents(targets)
    _run(
        (
            "chezmoi",
            "apply",
            str(targets[0]),
            *(str(path) for path in module_targets),
            *(str(path) for path in cleanup_targets),
            *(str(path) for path in targets[2:]),
        ),
        "chezmoi unit apply failed",
    )
    _validate_installed_launcher(targets[0], sources[0])
    _validate_installed_package(targets[1], module_targets, module_sources)
    _validate_installed_units(targets[2:], sources[2:])
    _run(
        ("systemctl", "--user", "daemon-reload"),
        "systemd user daemon reload failed",
    )
    _run(
        ("systemctl", "--user", "enable", "--now", *TIMER_NAMES),
        "timer enable failed",
    )
    print("Second Brain timer enabled.")


def _disable() -> None:
    _run(
        ("systemctl", "--user", "show-environment"),
        "systemd user manager is unavailable",
    )
    _run(
        ("systemctl", "--user", "disable", "--now", *TIMER_NAMES),
        "timer disable failed",
    )
    print("Second Brain timer disabled.")


def main(argv: Sequence[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        with _setup_lock(require_repository=not args.disable):
            if args.check:
                _check()
            elif args.enable:
                _enable()
            else:
                _disable()
    except TimerSetupError as error:
        print(f"setup-second-brain-timer: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
