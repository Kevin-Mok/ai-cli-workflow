#!/usr/bin/env python3
"""Optional local sound for Dunst's codex-kitty notifications. No sudo needed."""
import argparse
from contextlib import ExitStack
import fcntl
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import threading
import time


def _cli_message(text, icon):
    """Decorate human output; CLI_PLAIN=1 keeps legacy scripts undecorated."""
    import os
    import sys
    plain = os.environ.get('CLI_PLAIN') == '1' or '--plain' in sys.argv
    return ('' if plain else icon + ' ') + text

APP_NAME = 'codex-kitty'
VOICE = 'en_US-Voice Contributor-high'
VOICE_LABEL = 'Voice Contributor (US, high)'
LENGTH_SCALE = 0.95
SYNTHESIS_TIMEOUT = 30
_plain = False
_details = False


def display(message: str, icon: str = '') -> None:
    prefix = '' if _plain or not icon else icon + ' '
    width = max(20, shutil.get_terminal_size().columns)
    line = prefix + message
    print(line if len(line) <= width else line[:width - 3] + '...')


def setting_path() -> Path:
    return Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'codex-notification-sound/sound.json'


def error_log() -> Path:
    return Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'codex-notification-sound/errors.log'


def report_error(message: str) -> None:
    warning = message if _details else 'Audio needs attention; run status --details and preview --details.'
    print(f'{"Warning: " if _plain else "⚠️ "}{warning}', file=sys.stderr)
    try:
        path = error_log()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('a', encoding='utf-8') as output:
            output.write(f'{datetime.now(timezone.utc).isoformat()} {message}\n')
    except OSError:
        pass  # A read-only state directory must never break popup delivery.


def configured_clip() -> Path | None:
    path = setting_path()
    try:
        data = json.loads(path.read_text(encoding='utf-8'))
    except FileNotFoundError:
        return None
    if not isinstance(data, dict) or not isinstance(data.get('path'), str) or not data['path']:
        raise ValueError(f'invalid sound path in {path}; use set or disable')
    clip = Path(data['path'])
    if not clip.is_absolute() or not clip.is_file():
        raise ValueError(f'sound file is missing or path is not absolute: {clip}')
    return clip


def speech_enabled() -> bool:
    try:
        data = json.loads(setting_path().with_name('speech.json').read_text(encoding='utf-8'))
        return isinstance(data, dict) and data.get('enabled') is True
    except (OSError, ValueError, UnicodeError):
        return False


def voice_paths() -> tuple[Path, Path]:
    root = Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share') / 'codex-notification-speech'
    return root / 'venv/bin/python', root / 'voices' / f'{VOICE}.onnx'


def voice_ready() -> bool:
    python, model = voice_paths()
    return os.access(python, os.X_OK) and model.is_file() and model.with_suffix('.onnx.json').is_file()


def set_speech(enabled: bool) -> int:
    path = setting_path().with_name('speech.json')
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=path.parent, delete=False) as output:
        temporary = Path(output.name)
        json.dump({'enabled': enabled}, output)
        output.write('\n')
    try:
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
    display(f'Speech: {"enabled" if enabled else "disabled"}', '🗣️')
    if enabled:
        display('Resume affected sessions to load completion notifications.')
    return 0


def play(title: str | None = None, *, speech_only: bool = False) -> int:
    try:
        if speech_only and (title is None or not title.strip()):
            raise ValueError('--speech-only requires a nonblank --title')
        clip = None if speech_only else configured_clip()
        if clip is None and not speech_only:
            return 0
        player = shutil.which('mpv')
        if player is None:
            raise ValueError('mpv is unavailable on PATH')
        lock = error_log().with_name('playback.lock')
        lock.parent.mkdir(parents=True, exist_ok=True)
        with lock.open('a') as owner, ExitStack() as temporary_files:
            fcntl.flock(owner, fcntl.LOCK_EX)
            def playback(path: Path) -> None:
                result = subprocess.run(
                    [player, '--no-config', '--no-video', '--no-terminal',
                     '--audio-display=no', '--', str(path)],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, timeout=60, check=False)
                if result.returncode:
                    raise ValueError(f'mpv playback failed (exit {result.returncode}); preview the clip and check your audio output')
            synthesis: subprocess.Popen[bytes] | None = None
            synthesis_error: str | None = None
            watchdog: threading.Timer | None = None
            timed_out = threading.Event()
            wav: Path | None = None
            deadline = 0.0
            try:
                if title:
                    try:
                        if not voice_ready():
                            raise ValueError('voice unavailable; run setup-codex-notification-speech --install')
                        python, model = voice_paths()
                        temporary = temporary_files.enter_context(tempfile.TemporaryDirectory(prefix='codex-title-'))
                        wav = Path(temporary) / 'title.wav'
                        # A private, unlinked stdin file avoids blocking on a
                        # pipe while the clip waits to start. Titles stay local.
                        text = temporary_files.enter_context(tempfile.TemporaryFile(mode='w+t', encoding='utf-8'))
                        text.write(title + '\n')
                        text.seek(0)
                        deadline = time.monotonic() + SYNTHESIS_TIMEOUT
                        synthesis = subprocess.Popen(
                            [str(python), '-m', 'piper', '--model', str(model),
                             '--config', str(model.with_suffix('.onnx.json')),
                             '--length-scale', str(LENGTH_SCALE), '--output_file', str(wav)],
                            stdin=text, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        def enforce_deadline() -> None:
                            if synthesis is not None and synthesis.poll() is None:
                                timed_out.set()
                                synthesis.kill()
                        timer = threading.Timer(max(0.0, deadline - time.monotonic()), enforce_deadline)
                        timer.daemon = True
                        timer.start()
                        watchdog = timer
                    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError) as error:
                        synthesis_error = str(error)
                if clip is not None:
                    playback(clip)
                if synthesis is not None:
                    try:
                        synthesis.wait(timeout=max(0.0, deadline - time.monotonic()))
                        if watchdog is not None:
                            watchdog.cancel()
                            watchdog.join()
                        if timed_out.is_set():
                            raise subprocess.TimeoutExpired(synthesis.args, SYNTHESIS_TIMEOUT)
                        if synthesis.returncode or wav is None or not wav.is_file() or not wav.stat().st_size:
                            raise ValueError('Piper synthesis failed; run setup-codex-notification-speech --check')
                        playback(wav)
                    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError) as error:
                        if speech_only:
                            raise
                        report_error(str(error))  # The MP3 already played; never retry it.
                elif synthesis_error:
                    if speech_only:
                        raise ValueError(synthesis_error)
                    report_error(synthesis_error)
            finally:
                if watchdog is not None:
                    watchdog.cancel()
                    watchdog.join()
                if synthesis is not None:
                    if synthesis.poll() is None:
                        synthesis.kill()
                    synthesis.wait()  # Reap our child before removing its WAV.
        return 0
    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError) as error:
        report_error(str(error))
        return 1


def save_clip(value: str) -> int:
    temporary = None
    try:
        clip = Path(value).expanduser().resolve()
        if not clip.is_file():
            raise ValueError(f'sound file does not exist: {clip}')
        path = setting_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=path.parent, delete=False) as output:
            temporary = Path(output.name)
            json.dump({'path': str(clip)}, output)
            output.write('\n')
        os.replace(temporary, path)
        display(f'Sound configured: {clip.name}', '🔊')
        if _details:
            print(f'Clip: {clip}')
        return 0
    except (OSError, ValueError, RuntimeError) as error:
        report_error(str(error))
        return 1
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main(argv: list[str] | None = None) -> int:
    global _plain, _details
    args = list(sys.argv[1:] if argv is None else argv)
    # Dunst passes exactly five positional arguments. Notification text is
    # never parsed as a command or used to select audio.
    human_commands = {'set', 'preview', 'speech', 'disable', 'status', 'smoke', 'event-play'}
    if len(args) == 5 and args[0] not in human_commands and not args[0].startswith('-'):
        if args[0] == APP_NAME and not speech_enabled():
            play()
        return 0  # Sound failure never makes the notification script fail.

    presentation = argparse.ArgumentParser(add_help=False, description=_cli_message('codex notification sound', '🎙️'))
    presentation.add_argument('--plain', action='store_true', default=argparse.SUPPRESS, help='use ASCII output')
    presentation.add_argument('--details', action='store_true', default=argparse.SUPPRESS, help='show full paths and diagnostics')
    parser = argparse.ArgumentParser(description=_cli_message(__doc__, '🎙️'), parents=[presentation])
    commands = parser.add_subparsers(dest='command', required=True)
    configure = commands.add_parser('set', help='enable sound using a local MP3 path (quoted if it contains spaces)', parents=[presentation])
    configure.add_argument('path')
    preview = commands.add_parser('preview', help='preview the configured clip or a speech-only title', parents=[presentation])
    preview.add_argument('--title', help='speak this exact title after the clip, or alone with --speech-only')
    preview.add_argument('--speech-only', action='store_true', help='speak --title without the configured clip; requires nonblank text')
    speech = commands.add_parser('speech', help='switch hook audio; disable restores Dunst audio', parents=[presentation])
    speech.add_argument('state', choices=('enable', 'disable'))
    commands.add_parser('event-play', help=argparse.SUPPRESS, parents=[presentation])
    commands.add_parser('disable', help='remove the local setting; keep your clip', parents=[presentation])
    commands.add_parser('status', help='show setting path and enabled/disabled state', parents=[presentation])
    smoke = commands.add_parser('smoke', help='exercise the Dunst rule or emit an unrelated Kitty OSC 9 popup', parents=[presentation])
    smoke.add_argument('kind', choices=('tagged', 'kitty'))
    options = parser.parse_args(args)
    _plain = bool(getattr(options, 'plain', False)) or os.environ.get('CLI_PLAIN') == '1'
    _details = bool(getattr(options, 'details', False))
    if options.command == 'set':
        return save_clip(options.path)
    if options.command == 'preview':
        return play(options.title, speech_only=options.speech_only)
    try:
        if options.command == 'speech':
            return set_speech(options.state == 'enable')
        if options.command == 'event-play':
            if speech_enabled():
                title = json.load(sys.stdin)
                return play(title if isinstance(title, str) else None)
            return 0
        if options.command == 'disable':
            setting_path().unlink(missing_ok=True)
            display('Sound disabled; your clip is unchanged.', '🔇')
        elif options.command == 'status':
            clip = configured_clip()
            display('Codex notification audio', '🔊')
            display(f'  Sound   {"enabled" if clip else "disabled"}')
            display(f'  Speech  {"enabled" if speech_enabled() else "disabled"}')
            display(f'  Voice   {"ready" if voice_ready() else "not installed"}')
            display(f'  Model   {VOICE_LABEL}')
            display(f'  Pace    {LENGTH_SCALE} (slightly brisk)')
            if clip:
                display(f'  Clip    {clip.name}')
            display('Use setup-codex-notification-speech --check to verify the voice.')
            if _details:
                print(f'Clip: {clip if clip else "disabled"}\nSetting: {setting_path()}\nSpeech setting: {setting_path().with_name("speech.json")}\nErrors: {error_log()}')
                try:
                    lines = error_log().read_text(encoding='utf-8').splitlines()
                    if lines:
                        print('Recent diagnostic: ' + lines[-1])
                except OSError:
                    pass
        elif options.command == 'smoke':
            if options.kind == 'kitty':
                # The foreground emitter is this helper, not Codex. Even a
                # Codex-looking title must stay an ordinary, silent Kitty popup.
                print('\033]9;Codex approval text from an unrelated process\007', end='', flush=True)
            else:
                sender = shutil.which('notify-send')
                if sender is None:
                    raise ValueError('notify-send is unavailable on PATH')
                result = subprocess.run([sender, '--app-name', APP_NAME, '--expire-time', '5000',
                                         'Codex sound rule check', 'Synthetic Dunst rule check; real Codex checks are separate.'], check=False)
                return result.returncode
        return 0
    except (OSError, ValueError, UnicodeError) as error:
        report_error(str(error))
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
