#!/usr/bin/env python3
"""Local exact-candidate privacy gate. No candidate bytes leave this process."""
import sys

try:
    from privacy_gate import main
except Exception:
    prefix = "" if "--plain" in sys.argv else "🔒 "
    print(prefix + "Privacy gate ERROR: scanner unavailable; commit refused.", file=sys.stderr)
    raise SystemExit(2)

if __name__ == "__main__":
    raise SystemExit(main())
