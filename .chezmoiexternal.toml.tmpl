{{ if not (get . "migrationOffline" | default false) }}
[".codex/superpowers"]
    type = "archive"
    url = {{ (gitHubLatestRelease "obra/superpowers").TarballURL | quote }}
    exact = true
    stripComponents = 1

[".codex/skills/upstreams/impeccable"]
    type = "git-repo"
    url = "https://github.com/pbakaus/impeccable.git"
    refreshPeriod = "24h"
    [".codex/skills/upstreams/impeccable".pull]
        args = ["--ff-only"]

[".codex/skills/upstreams/21st"]
    type = "git-repo"
    url = "https://github.com/21st-dev/skill.git"
    refreshPeriod = "24h"
